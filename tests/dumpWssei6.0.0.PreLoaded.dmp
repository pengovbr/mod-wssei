DROP TABLE IF EXISTS `login_sso`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `login_sso` (
  `id_login_sso` varchar(26) NOT NULL,
  `id_sistema` int NOT NULL,
  `id_servico_sso` int NOT NULL,
  `cpf` bigint DEFAULT NULL,
  `nome` varchar(100) DEFAULT NULL,
  `nome_social` varchar(100) DEFAULT NULL,
  `email` varchar(100) DEFAULT NULL,
  `telefone` varchar(50) DEFAULT NULL,
  `sta_login_sso` char(1) NOT NULL,
  `dth_login_sso` datetime NOT NULL,
  `origem` varchar(4000) DEFAULT NULL,

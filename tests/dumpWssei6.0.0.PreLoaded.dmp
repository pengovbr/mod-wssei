entregue &agrave; CONTRATADA, fato este comprovado mediante a assinatura eletr&ocirc;nica de seu representante legal neste documento ou certificado em documento pr&oacute;prio no presente processo.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(537,79,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(538,79,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(539,80,'Cabeçalho','<div align=\"center\">@timbre_orgao@<br />\r\n@descricao_orgao_maiusculas@</div>\r\n',0,'S','N','N','S','S','N','S','S'),(540,80,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(541,80,'Processo','Processo nº @processo@',20,'S','N','N','S','N','N','N','S'),(542,80,'Corpo do Texto','<p class=\"Item_Nivel1\" contenteditable=\"false\">IDENTIFICA&Ccedil;&Atilde;O</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left: auto; margin-right: auto; width: 98%;\">\r\n	<tbody>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&Aacute;rea Requisitante da Solu&ccedil;&atilde;o:</p>\r\n			</th>\r\n			<td style=\"border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"border-color: rgb(0, 0, 0); width: 20%; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Nome do Projeto:</p>\r\n			</th>\r\n	
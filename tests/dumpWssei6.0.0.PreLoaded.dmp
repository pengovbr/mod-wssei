--
-- Table structure for table `login`
--

DROP TABLE IF EXISTS `login`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `login` (
  `id_login` char(128) NOT NULL,
  `id_sistema` int NOT NULL,
  `id_usuario` int NOT NULL,
  `dth_login` datetime NOT NULL,
  `hash_interno` char(128) NOT NULL,
  `hash_usuario` char(128) NOT NULL,
  `hash_agente` char(128) NOT NULL,
  `id_usuario_emulador` int DEFAULT NULL,
  `http_client_ip` varchar(39) DEFAULT NULL,
  `remote_addr` varchar(39) DEFAULT NULL,
  `http_x_forwarded_for` varchar(39) DEFAULT NULL,
  `sta_login` char(1) NOT NULL,
  `user_agent` varchar(500) NOT NULL,
  `id_dispositivo_acesso` varchar(26) DEFAULT NULL,
  `id_codigo_acesso` varchar(26) DEFAULT NULL,
  `id_login_sso` varchar(26) DEFAULT NULL,
  PRIMARY KEY (`id_login`,`id_usuario`,`id_sistema`),
  KEY `fk_login_usuario_emulador` (`id_usuario_emulador`),
  KEY `fk_login_sistema` (`id_sistema`),
  KEY `fk_login_usuario` (`id_usuario`),
  KEY `i04_login` (`id_login`,`id_sistema`,`id_usuario`,`sta_login`),
  KEY `i05_login` (`id_login`,`id_sistema`,`id_usuario`,`dth_login`),
  KEY `i06_login` (`hash_usuario`,`dth_login`,`sta_login`),
  KEY `i07_login` (`dth_login`),
  KEY `fk_login_dispositivo_acesso` (`id_dispositivo_acesso`),
  KEY `fk_login_codigo_acesso` (`id_codigo_acesso`),
  KEY `fk_login_login_sso` (`id_login_sso`),
  CONSTRAINT `fk_login_codigo_acesso` FOREIGN KEY (`id_codigo_acesso`) REFERENCES `codigo_acesso` (`id_codigo_acesso`),
  CONSTRAINT `fk_login_dispositivo_acesso` FOREIGN KEY (`id_dispositivo_acesso`) REFERENCES `dispositivo_acesso` (`id_dispositivo_acesso`),
  CONSTRAINT `fk_login_login_sso` FOREIGN KEY (`id_login_sso`) REFERENCES `login_sso` (`id_login_sso`),
  CONSTRAINT `fk_login_sistema` FOREIGN KEY (`id_sistema`) REFERENCES `sistema` (`id_sistema`),
  CONSTRAINT `fk_login_usuario` FOREIGN KEY (`id_usuario`) REFERENCES `usuario` (`id_usuario`),
  CONSTRAINT `fk_login_usuario_emulador` FOREIGN KEY (`id_usuario_emulador`) REFERENCES `usuario` (`id_usuario`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
/*!40101 SET character_set_client = @saved_cs_client */;


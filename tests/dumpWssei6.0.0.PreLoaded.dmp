td>\r\n			<td style=\"width: 290px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">DADOS DO EMPENHO</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left: 3pt; margin-right: auto; width: 98%;\">\r\n	<tbody>\r\n		<tr>\r\n			<td contenteditable=\"false\" style=\"width: 361px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">N&uacute;mero do Empenho:</p>\r\n			</td>\r\n			<td style=\"width: 927px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\"><span style=\"color:#0000FF;\">[Digite aqui o n&uacute;mero de identifica&ccedil;&atilde;o do empenho]</span></p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td contenteditable=\"false\" style=\"width: 361px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Data do Empenho:</p>\r\n			</td>\r\n			<td style=\"width: 927px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\"><span style=\"color:#0000FF;\">[Digite aqui a data do empenho no formato dd/mm/aaaa]</span></p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">FORMA DE UTILIZA&Ccedil;&Atilde;O</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left:auto;margin-right:auto;width:98%;\">\r\n	<tbody>\r\n		<tr>\r\n			<td colspan=\"1\" contenteditable=\"false\" rowspan=\"2\" style=\"width: 130px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Data</strong></p>\r\n			</td>\r\n			<td colspan=\"1\" contenteditable=\"false\" rowspan=\"2\" style=\"width: 530px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Identifica&ccedil;&atilde;o d
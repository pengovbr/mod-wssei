INSERT INTO `secao_modelo` VALUES (162,27,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(163,27,'Processo e Interessado','<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">&nbsp;&nbsp;</p>\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Processo nº @processo@</p>\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Interessado: @interessados_virgula_espaco@</p>\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">&nbsp;&nbsp;</p>',20,'S','N','N','S','N','N','S','S'),(164,27,'Corpo do Texto','<p class=\"Texto_Justificado_Recuo_Primeira_Linha\"><strong>O [DIGITE AQUI O NOME DO CARGO DO SIGNAT&Aacute;RIO] DA @descricao_orgao_maiusculas@</strong>, no uso de suas atribui&ccedil;&otilde;es legais e regulamentares, em especial a disposta no art. XX, inciso ZZ, do Regimento Interno da @sigla_orgao_origem@, aprovado pela [nome_norma] n&ordm; [numero_da_norma], de [dia] de [mes] de [ano], examinando os autos do Processo em ep&iacute;grafe, [digite aqui o texto do conte&uacute;do principal do documento].</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">[digite aqui o texto do conte&uacute;do principal do documento]</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">[digite aqui o texto do conte&uacute;do principal do documento]</p>\r\n',30,'N','N','S','N','N','N','S','S'),(165,27,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(166,28,'Título do Documento','@serie@ Nº @numeracao_serie@, DE @dia@ DE @mes_extenso@ DE @ano@',10,'S','N','N','S','N','N','N','S'),(167,28,'Corpo do Texto','<p class=\"Texto_Justificado_Recuo_Primeira_Linha\"><b>O [DIGITE AQUI O NOME DO CARGO] DA @descricao_orgao_maiusculas@</b>, no uso das atribui&ccedil;&otilde;es que lhe foram conferidas pelo art. [DIGITE AQUI O DISPOSITIVO] do Regimento Interno da @sigla_orgao_origem@, aprovado pela [INDIQUE AQUI A NORMA QUE APROVOU O REGIMENTO INTERNO], e</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO ... ... ...;</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO ... ... ...;</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO o constante dos autos do processo n&ordm; @processo@;</p>\r\n\r\n<p class=\"Texto_Espaco_Duplo_Recuo_Primeira_Linha\">RESOLVE:</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 1&ordm;&nbsp; Aprovar ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 2&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Par&aacute;grafo &uacute;nico.&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 3&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">&sect; 1&ordm;&nbsp; Digite aqui o texto ... .... :</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">I - Digite aqui o texto ... .... :</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">a) Digite aqui o texto ... .... :</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">b) Digite aqui o texto ... .... :</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">1. Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">2. Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">c) Digite aqui o texto ... .... :</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">&sect; 2&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 4&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 5&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 6&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 7&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 8&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 9&ordm;&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 10.&nbsp; Digite aqui o texto ... .... .</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Art. 11.&nbsp; Este Ato entra em vigor na data de publica&ccedil;&atilde;o de seu extrato no Di&aacute;rio Oficial da Uni&atilde;o.</p>\r\n',20,'N','N','S','N','N','N','S','S'),(168,28,'Assinatura',NULL,30,'N','S','N','N','N','N','N','S'),(173,30,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(174,30,'Corpo do Texto','<p class=\"Paragrafo_Numerado_Nivel1\">O&nbsp;processo em ep&iacute;grafe foi devidamente convertido do suporte f&iacute;sico para eletr&ocirc;nico no SEI, em conformidade com o disposto no [dispositivo] da [norma], mantendo o mesmo n&uacute;mero do processo f&iacute;sico (NUP) e mesmo interessado.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Foi efetivada marca&ccedil;&atilde;o da referida&nbsp;convers&atilde;o no cadastro do processo no [nome do sistema legado]&nbsp;e que o processo f&iacute;sico ser&aacute; imediatamente encaminhado para o Arquivo Geral.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Fica encerrada a tramita&ccedil;&atilde;o do processo em suporte f&iacute;sico, sendo vedada qualquer&nbsp;juntada f&iacute;sica de novos documentos, para, a partir de ent&atilde;o, ter continuidade de sua instru&ccedil;&atilde;o e tramita&ccedil;&atilde;o somente por meio do SEI.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Para fins de registro, o&nbsp;processo originalmente em suporte f&iacute;sico era composto de:</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">Folhas: [DIGITE AQUI&nbsp;A QUANTIDADE TOTAL DE FOLHAS]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">Volumes: [DIGITE AQUI&nbsp;A&nbsp;QUANTIDADE DE VOLUMES]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">M&iacute;dias: [DIGITE AQUI A QUANTIDADE TOTAL DE M&Iacute;DIAS]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">O processo eletr&ocirc;nico resultante da presente convers&atilde;o ficou composto da seguinte forma:</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">Volume de Processo: [DIGITE AQUI A QUANTIDADE TOTAL DE ARQUIVOS DE VOLUMES]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">Apartado Sigiloso: [DIGITE AQUI A QUANTIDADE TOTAL DE ARQUIVOS DE APARTADOS SIGILOSOS]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel2\">Conte&uacute;do de M&iacute;dia: [DIGITE AQUI A QUANTIDADE TOTAL DE ARQUIVOS DE CONTE&Uacute;DO DE M&Iacute;DIA]</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Em cumprimento ao disposto no art. 3&ordm;, <strong>caput</strong>, da <a href=\"http://www.planalto.gov.br/ccivil_03/_ato2011-2014/2012/Lei/L12682.htm\" target=\"_blank\">Lei n&ordm; 12.682, de 9 de julho de 2012</a>, os arquivos PDF oriundos da digitaliza&ccedil;&atilde;o da documenta&ccedil;&atilde;o em suporte f&iacute;sico (papel) foram devidamente submetidos a procedimento de confer&ecirc;ncia e autentica&ccedil;&atilde;o por servidor p&uacute;blico, por meio de sua assinatura eletr&ocirc;nica com emprego de certificado digital emitido no &acirc;mbito da ICP-Brasil.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Unidade respons&aacute;vel pela convers&atilde;o: @sigla_unidade@</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">A conclus&atilde;o do procedimento de convers&atilde;o se deu na data de assinatura do presente Termo.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(175,30,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(189,34,'Título do Documento','@serie@ nº @numeracao_serie@/@ano@',10,'S','N','N','S','N','N','N','S'),(191,34,'Separação de Seção',NULL,20,'S','N','N','N','N','N','N','S'),(193,34,'Corpo do Texto','<p class=\"Texto_Justificado_Recuo_Primeira_Linha\"><strong>O [DIGITE AQUI O NOME DO CARGO DO SIGNAT&Aacute;RIO] DA @descricao_orgao_maiusculas@</strong>, no uso de suas atribui&ccedil;&otilde;es legais e regulamentares, em especial a disposta no art. XX, inciso ZZ, do Regimento Interno da @sigla_orgao_origem@, aprovado pela [nome_norma] n&ordm; [numero_da_norma], de [dia] de [mes] de [ano], examinando os autos do Processo em ep&iacute;grafe, [digite aqui o texto do conte&uacute;do principal do documento].</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">[digite aqui o texto do conte&uacute;do principal do documento]</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">[digite aqui o texto do conte&uacute;do principal do documento]</p>\r\n',30,'N','N','S','N','N','N','S','S'),(195,34,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(200,36,'Título do Documento','@serie@ Nº @numeracao_serie@/@ano@/@hierarquia_unidade_invertida@',10,'S','N','N','S','N','N','N','S'),(201,36,'Processo','PROCESSO Nº @processo@',20,'S','N','N','S','N','N','N','S'),(203,36,'Interessado','INTERESSADO: @interessados_virgula_espaco_maiusculas@',30,'S','N','N','S','N','N','N','S'),(205,36,'Assinatura',NULL,50,'N','S','N','N','N','N','N','S'),(207,36,'Corpo do Texto','<p class=\"Texto_Fundo_Cinza_Maiusculas_Negrito\">CONSELHEIRO RELATOR</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Digite aqui o nome do Conselheiro</p>\r\n\r\n<p class=\"Item_Nivel1\">ASSUNTO</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto... .... .</p>\r\n\r\n<p class=\"Item_Nivel1\">EMENTA</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">DIGITE O TEXTO EM CAIXA ALTA</p>\r\n\r\n<p class=\"Item_Nivel2\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel2\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel3\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel3\">Texto:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto:</p>\r\n\r\n<p class=\"Item_Alinea_Letra\">Texto; e</p>\r\n\r\n<p class=\"Item_Alinea_Letra\">Texto.</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel2\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel1\">REFER&Ecirc;NCIAS</p>\r\n\r\n<p class=\"Item_Nivel2\">Parecer da Procuradoria n&ordm; xxx/aaaa.</p>\r\n\r\n<p class=\"Item_Nivel1\">RELAT&Oacute;RIO</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>DOS FATOS</strong></p>\r\n\r\n<p class=\"Item_Nivel3\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel3\">Texto:</p>\r\n\r\n<p class=\"Item_Nivel4\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel4\">Texto:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto:</p>\r\n\r\n<p class=\"Item_Alinea_Letra\">Texto; e</p>\r\n\r\n<p class=\"Item_Alinea_Letra\">Texto.</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel3\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>DA AN&Aacute;LISE</strong></p>\r\n\r\n<p class=\"Item_Nivel3\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel3\">Texto.</p>\r\n\r\n<p class=\"Item_Nivel4\">Texto:</p>\r\n\r\n<p class=\"Citacao\">Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o. Cita&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel4\">Texto.</p>\r\n\r\n<p class=\
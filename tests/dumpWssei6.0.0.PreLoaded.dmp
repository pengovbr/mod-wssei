  `destino_logout` varchar(4000) NOT NULL,
  `http_client_ip` varchar(39) DEFAULT NULL,
  `http_x_forwarded_for` varchar(39) DEFAULT NULL,
  `remote_addr` varchar(39) DEFAULT NULL,
  `user_agent` varchar(500) NOT NULL,
  `sta_nivel_confiabilidade` char(1) DEFAULT NULL,
  `sta_tipo_acesso` char(1) NOT NULL,
  `sta_erro` int DEFAULT NULL,
  `state` varchar(32) DEFAULT NULL,
  `sin_certificado_digital` char(1) DEFAULT NULL,
  `sin_2_fatores` char(1) DEFAULT NULL,
  PRIMARY KEY (`id_login_sso`),
  KEY `fk_login_sso_servico_sso` (`id_servico_sso`),
  KEY `fk_login_sso_sistema` (`id_sistema`),
  CONSTRAINT `fk_login_sso_servico_sso` FOREIGN KEY (`id_servico_sso`) REFERENCES `servico_sso` (`id_servico_sso`),
  CONSTRAINT `fk_login_sso_sistema` FOREIGN KEY (`id_sistema`) REFERENCES `sistema` (`id_sistema`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

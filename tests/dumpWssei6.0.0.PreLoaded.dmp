INSERT INTO `serie` VALUES ('Resolução','Ato normativo com efeitos internos ao órgão que a criou ou a outros órgãos subordinados.','S',NULL,1,1,'N','N','2','S',56,'T','N',NULL,'N','N'),('Súmula','Expressa decisão quanto à interpretação da legislação e fixa entendimento sobre matérias de competência do Órgão, com efeito vinculativo.','S',NULL,1,2,'N','N','2','S',60,'T','N',NULL,'N','N'),('Ato','Expressa decisão sobre outorga, expedição, modificação, transferência, prorrogação, adaptação e extinção de concessões, permissões e autorizações para exploração de serviços, uso de recursos escassos e exploração de satélite, e Chamamento Público.','S',NULL,1,3,'S','N','4','S',28,'T','N',NULL,'N','N'),('Despacho Decisório','Expressa decisão sobre matérias não abrangidas pelos demais instrumentos deliberativos.','S',NULL,1,4,'S','N','3','S',48,'I','N',NULL,'N','N'),('Despacho','Manifestação de mero expediente, sem cunho decisório, não abrangida pelos demais instrumentos deliberativos, que promove uma providência ordinatória propulsora do processo administrativo.','S',NULL,1,5,'S','N','S','S',39,'T','N',NULL,'N','N'),('Análise','Como Documento Externo pode ser complementado: Contábil','S',NULL,1,7,'S','N','3','S',36,'T','N',NULL,'N','N'),('Acórdão','Expressa decisão proferida pelo Conselho Diretor, não abrangida pelos demais instrumentos deliberativos anteriores.','S',NULL,1,8,'S','N','4','S',43,'T','N',NULL,'N','N'),('Portaria','Expressa decisão relativa a assuntos de interesse interno da Agência.','S',NULL,1,10,'N','N','4','S',57,'T','N',NULL,'N','N'),('Ofício','Modalidades de comunicação oficial. É expedido para e pelas autoridades. Tem como finalidade o tratamento de assuntos oficiais pelos órgãos da Administração Pública entre si e também com particulares.','S',NULL,1,11,'N','S','3','S',58,'T','N',NULL,'N','N'),('Memorando','Como Documento Externo pode ser complementado: de Entendimento','S',NULL,1,12,'N','S','3','S',51,'T','N',NULL,'N','N'),('Memorando-Circular','Mesma definição do Memorando com apenas uma diferença: é encaminhado simultaneamente a mais de um cargo.','S',NULL,1,13,'N','S','3','S',53,'T','N',NULL,'N','N'),('Comunicado',NULL,'S',NULL,2,14,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Nota Técnica','Instrumento de comunicação interna ou externa que expressa um juízo ou opinião sobre questão técnica, com vistas a esclarecer dúvidas ou indagações.','S',NULL,1,15,'S','N','3','S',64,'I','N',NULL,'N','N'),('Informe','Podendo ser complementado: de Rendimentos','S',NULL,2,16,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Referendo',NULL,'S',NULL,1,27,'S','N','3','S',48,'T','N',NULL,'N','N'),('Parecer (AGU)','Tipo de Documento próprio da AGU (vide anexo à Portaria 1399/2009 da AGU).','S',NULL,1,28,'S','N','3','S',55,'I','N',NULL,'N','N'),('Cota','Tipo de Documento próprio da AGU (vide anexo à Portaria 1399/2009 da AGU).','S',NULL,1,29,'S','N','3','S',50,'T','N',NULL,'N','N'),('E-mail','Indicado nos Parâmetros para corresponder ao envio de Correspondência Eletrônica do SEI','S',NULL,1,30,'S','N','3','S',48,'T','N',NULL,'N','N'),('Balancete','Podendo ser complementado: Financeiro','S',NULL,2,32,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Balanço','Podendo ser complementado: Patrimonial - BP; Financeiro','S',NULL,2,33,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Boletim','Podendo ser complementado: de Ocorrência; Informativo','S',NULL,2,34,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Comprovante','Podendo ser complementado: de Despesa; de Rendimento; de Residência; de Matrícula; de União Estável','S',NULL,2,35,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Conta','Podendo ser complementado: Telefônica; de Água; de Luz','S',NULL,2,36,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Contrato','Como Documento Externo pode ser complementado: Social','S',NULL,1,37,'S','N','4','S',71,'T','N',NULL,'N','N'),('Correspondência',NULL,'S',NULL,2,38,'N','N','S','S',NULL,'E','N',NULL,'N','N'),('Croqui','Podendo ser complementado: de Acesso, Urbano','S'
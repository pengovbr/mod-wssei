  CONSTRAINT `fk_usuario_historico_usu_oper` FOREIGN KEY (`id_usuario_operacao`) REFERENCES `usuario` (`id_usuario`),
  CONSTRAINT `fk_usuario_historico_usuario` FOREIGN KEY (`id_usuario`) REFERENCES `usuario` (`id_usuario`)

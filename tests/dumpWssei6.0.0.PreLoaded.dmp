7px; background-color: rgb(255, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFFF00;\">M&eacute;dia</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFFF00;\">M&eacute;dia</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 153, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFA500;\">Alta</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 153, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFA500;\">Alta</span></p>\r\n			</td>\r\n			<td style=\"width:132px;\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width:142px;\">\r\n			<p align=\"right\" class=\"Tabela_Texto_Alinhado_Direita\">M&eacute;dia</p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(51, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#00FF00;\">Ba</span><span style=\"background-color:#00FF00;\">ixa</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFFF00;\">M&eacute;di</span><span style=\"background-color:#FFFF00;\">a</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-color:#FFFF00;\">M&eacute;d</span><span style=\"background-color:#FFFF00;\">ia</span></p>\r\n			</td>\r\n			<td style=\"width: 57px; background-color: rgb(255, 255, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><span style=\"background-col
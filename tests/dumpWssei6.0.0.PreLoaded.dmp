--
-- Table structure for table `ciencia`
--

DROP TABLE IF EXISTS `ciencia`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `ciencia` (
  `id_ciencia` bigint NOT NULL,
  `id_protocolo` bigint NOT NULL,
  `id_usuario` int NOT NULL,
  `id_unidade` int NOT NULL,
  `id_atividade` int NOT NULL,
  `id_procedimento_anexado` bigint DEFAULT NULL,
  PRIMARY KEY (`id_ciencia`),
  KEY `fk_ciencia_protocolo` (`id_protocolo`),
  KEY `fk_ciencia_usuario` (`id_usuario`),
  KEY `fk_ciencia_unidade` (`id_unidade`),
  KEY `fk_ciencia_atividade` (`id_atividade`),
  KEY `fk_ciencia_proc_anexado` (`id_procedimento_anexado`),
  KEY `i01_ciencia` (`id_protocolo`,`id_usuario`),
  KEY `i02_ciencia` (`id_protocolo`,`id_procedimento_anexado`,`id_usuario`),
  CONSTRAINT `fk_ciencia_atividade` FOREIGN KEY (`id_atividade`) REFERENCES `atividade` (`id_atividade`),

n		</tr>\r\n		<tr>\r\n			<td style=\"width: 455px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Servidor</strong></p>\r\n			</td>\r\n			<td style=\"width: 458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Fun&ccedil;&atilde;o no Projeto</strong></p>\r\n			</td>\r\n			<td style=\"width: 334px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>&Aacute;rea de Lota&ccedil;&atilde;o</strong></p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Ramal</strong></p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 334px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 455px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 334px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">identifica&ccedil;&atilde;o da equipe da EMPRESA TERCEIRIZADA</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" height=\"42\" style=\"margin-left: auto; margin-right: auto; width: 98%;\" width=\"1468\">\r\n	<tbody>\r\n		<tr>\r\n			<th scope=\"row\" style=\"width: 20%; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Gerente do Projeto:</p>\r\n			</th>\r\n			<td style=\"width:1036px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th scope=\"row\" style=\"width: 20%; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Substituto:</p>\r\n			</th>\r\n			<td style=\"width:1036px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" height=\"82\" style=\"margin-left: auto; margin-right: auto; width: 98%;\" width=\"1478\">\r\n	<tbody>\r\n		<tr>\r\n			<td colspan=\"3\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>EQUIPE DA EMPRESA TERCEIRIZADA ENVOLVIDA NO PROJETO</strong></p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Nome</strong></p>\r\n			</td>\r\n			<td style=\"width:458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Fun&ccedil;&atilde;o no Projeto</strong></p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong>Ramal</strong></p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width:458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width:455px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width:458px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Item_Nivel1\">restri&ccedil;&otilde;es</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>: Uma restri&ccedil;&atilde;o &eacute; uma limita&ccedil;&atilde;o aplic&aacute;vel, interna ou externa ao projeto, que afetar&aacute; o desempenho do projeto ou de um processo. Listar os fatos que n&atilde;o podem ser alterados e que limitam as op&ccedil;&otilde;es da equipe do projeto. Registrar tudo o que limita as a&ccedil;&otilde;es/atividades a serem empreendidas/desenvolvidas no projeto, ou seja, tudo o que delimita o universo quanto a: recursos, prazos de execu&ccedil;&atilde;o, pol&iacute;ticas, diretrizes, etc.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">premissas</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>:<span> </span>As premissas s&atilde;o fatores que, para fins de planejamento, s&atilde;o considerados verdadeiros, reais ou certos sem prova ou demonstra&ccedil;&atilde;o. As premissas afetam todos os aspectos do planejamento do projeto e fazem parte da elabora&ccedil;&atilde;o progressiva do projeto. Frequentemente, as equipes do projeto identificam, documentam e validam as premissas durante o processo de planejamento.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">principais entregas do projeto</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>:&nbsp;Listar os principais produtos deste projeto. Inclua datas, locais e quantidades, conforme o caso.</span></p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" height=\"50\" style=\"margin-left: auto; margin-right: auto; width: 98%;\" width=\"1462\">\r\n	<thead>\r\n		<tr>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong><span style=\"background-color:#D3D3D3;\">Principais Entregas</span></strong></p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong><span style=\"background-color:#D3D3D3;\">Data</span></strong></p>\r\n			</th>\r\n		</tr>\r\n	</thead>\r\n	<tbody>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Item_Nivel1\">exclus&otilde;es (n&atilde;o escopo)</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>: Descrever de forma expl&iacute;cita o que est&aacute; exclu&iacute;do do projeto, para evitar que uma parte interessada possa supor que um produto, servi&ccedil;o ou resultado espec&iacute;fico &eacute; um produto do projeto.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">or&ccedil;amento previsto</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">Alinhamento estrat&eacute;gico</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>:<span><span> </span></span>Descrever o alinhamento da demanda com os instrumentos de planejamento institucional, como por exemplo: Plano Plurianual (PPA), Planejamento Estrat&eacute;gico (PeT), Plano Diretor de Tecnologia da Informa&ccedil;&atilde;o (PDTI) etc. <strong>Esse item consta no Documento de Oficializa&ccedil;&atilde;o da Demanda (DOD)&nbsp;e pode ser complementado ou revisado neste documento</strong>.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">partes interessadas</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>:<span><span> </span></span>Identificar as pessoas, grupos e/ou &oacute;rg&atilde;os da estrutura organizacional que apresentam algum interesse, favor&aacute;vel ou n&atilde;o, nos resultados do projeto. No campo &ldquo;requisito de interesse&rdquo;, identifique qual o interesse da parte no projeto.</span></p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" height=\"50\" style=\"margin-left: auto; margin-right: auto; width: 98%;\" width=\"1460\">\r\n	<thead>\r\n		<tr>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong><span style=\"background-color:#D3D3D3;\">Interessado</span></strong></p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><strong><span style=\"background-color:#D3D3D3;\">Requisito de Interesse</span></strong></p>\r\n			</th>\r\n		</tr>\r\n	</thead>\r\n	<tbody>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Item_Nivel1\">riscos previamente identificados</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>: Identificar eventos ou condi&ccedil;&otilde;es incertos que, se ocorrerem, provocar&atilde;o efeitos positivos ou negativos nos objetivos do projeto.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel1\">considera&ccedil;&otilde;es</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Orienta&ccedil;&atilde;o (apagar)</strong>: Listar quaisquer considera&ccedil;&otilde;es que n&atilde;o tenham sido contempladas nos itens anteriores.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto].</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n',30,'N','N','S','N','N','N','S','S'),(662,100,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(663,100,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(664,101,'Cabeçalho','<p class=\"Texto_Centralizado_Maiusculas_Negrito\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Te
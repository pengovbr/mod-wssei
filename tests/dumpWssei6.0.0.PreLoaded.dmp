	<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 530px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 277px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 175px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 130px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 530px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 277px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 175px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 130px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 530px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 277px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 175px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 130px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 530px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 277px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 175px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 130px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 530px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 277px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td style=\"width: 175px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"3\" contenteditable=\"false\" rowspan=\"1\" style=\"width: 967px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Direita\"><strong>Total do Suprimento de Fundos Concedido:</strong></p>\r\n			</td>\r\n			<td colspan=\"2\" rowspan=\"1\" style=\"width: 321px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"3\" contenteditable=\"false\" rowspan=\"1\" style=\"width: 967px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Direita\"><strong>Total da Despesa Realizada (saque/fatura):</strong></p>\r\n			</td>\r\n			<td colspan=\"2\" rowspan=\"1\" style=\"width: 321px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"3\" contenteditable=\"false\" rowspan=\"1\" style=\"width: 967px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Direita\"><strong>Total n&atilde;o Sacado:</strong></p>\r\n			</td>\r\n			<td colspan=\"2\" rowspan=\"1\" style=\"width: 321px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"3\" contenteditable=\"false\" rowspan=\"1\" style=\"width: 967px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Direita\"><strong>Total a Recolher:</strong></p>\r\n			</td>\r\n			<td colspan=\"2\" rowspan=\"1\" style=\"width: 321px;\">\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">O presente documento segue assinado pelo Suprido. Para continuidade do procedimento e aprova&ccedil;&atilde;o das contas, este processo deve ser encaminhado ao Ordenador de Despesa competente.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(736,112,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(737,112,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(738,113,'Cabeçalho','<div align=\"center\">@timbre_orgao@\r\n<p style=\"margin:0;font-family:Calibri;font-size:9pt;\">@descricao_orgao_maiusculas@<br />\r\n@endereco_unidade@, @complemento_endereco_unidade@ @hifen_bairro_unidade@, @cidade_unidade@/@sigla_uf_unidade@, @cep_unidade@<br />\r\nTelefone: @telefone_unidade@ e Fax: @fax_unidade@ @hifen_sitio_internet_orgao@<br />\r\n&nbsp;&nbsp;</p>\r\n</div>\r\n',0,'S','N','N','S','S','N','S','S'),(739,113,'Título do Documento','@serie@ nº @numeracao_serie@/@ano@',10,'S','N','N','S','N','N','N','S'),(740,113,'Processo','<p class=\"Texto_Justificado\">Processo n&ordm; @processo@</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n',20,'S','N','N','S','N','N','S','S');
INSERT INTO `secao_modelo` VALUES (741,113,'Corpo do Texto','<p class=\"Texto_Justificado\">PREG&Atilde;O ELETR&Ocirc;NICO PARA REGISTRO DE PRE&Ccedil;OS N&ordm; <span style=\"color:#0000FF;\">XX/XXXX</span></p>\r\n\r\n<p class=\"Texto_Justificado\"><strong>Validade da Ata:</strong> <span style=\"color:#0000FF;\">XX</span>&nbsp;meses</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\">Aos <span style=\"color:#0000FF;\">XX</span> dias do m&ecirc;s de <span style=\"color:#0000FF;\">XXXXXXXX</span> de @ano@, a Uni&atilde;o, por interm&eacute;dio da <strong>@descricao_orgao_maiusculas@ &ndash;&nbsp;@sigla_orgao_origem@</strong>, inscrita no CNPJ/MF sob o n&ordm;&nbsp;<span style=\"color:#0000FF;\">[digite aqui o CNPJ]</span>, com sede na&nbsp;<span style=\"color:#0000FF;\">[digite aqui o endere&ccedil;o completo]</span>, doravante denominada CONTRATANTE,&nbsp;por interm&eacute;dio do seu <span style=\"color:#0000FF;\">[Cargo do Signat&aacute;rio 1]</span>, Senhor(a) <span style=\"color:#0000FF;\">[digite aqui o nome]</span>, <span style=\"color:#0000FF;\">[nacionalidade]</span>, <span style=\"color:#0000FF;\">[estado civil]</span>, portador da Carteira de Identidade n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span> e do CPF n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span>, e do seu <span style=\"color:#0000FF;\">[Cargo do Signat&aacute;rio 2]</span>, Senhor(a) <span style=\"color:#0000FF;\">[digite aqui o nome]</span>, <span style=\"color:#0000FF;\">[nacionalidade]</span>, <span style=\"color:#0000FF;\">[estado civil]</span>, portador da Carteira de Identidade n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span>, CPF n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span>,</p>\r\n\r\n<p class=\"Texto_Justificado\">CONSIDERANDO o disposto na Lei n&ordm; 10.520/2002, no Decreto n&ordm; 7.892/2013, no Decreto n&ordm; 8.250/2014, no Decreto n&ordm; 5.450/2005, no Decreto n&ordm; 3.722/2001, aplicando-se, subsidiariamente, a Lei n&ordm; 8.666/1993, e as demais normas legais correlatas; e</p>\r\n\r\n<p class=\"Texto_Justificado\">CONSIDERANDO a classifica&ccedil;&atilde;o das propostas apresentadas no Preg&atilde;o Eletr&ocirc;nico para Registro de Pre&ccedil;os em ep&iacute;grafe, conforme Ata publicada em <span style=\"color:#0000FF;\">XX/XX/XXXX</span>, homologada pela autoridade competente,</p>\r\n\r\n<p class=\"Texto_Justificado\"><strong>RESOLVE:</strong></p>\r\n\r\n<p class=\"Texto_Justificado\">REGISTRAR OS PRE&Ccedil;OS para a eventual contrata&ccedil;&atilde;o dos itens a seguir elencados, conforme <span>Cl&aacute;usulas abaixo e&nbsp;</span>especifica&ccedil;&otilde;es do Termo de Refer&ecirc;ncia, que passa a fazer parte integrante desta, tendo sido, os referidos pre&ccedil;os, oferecidos pela<span>&nbsp;</span><span style=\"color:#0000FF;\"><strong>[DIGITE AQUI O NOME DA EMPRESA]</strong></span><span>, inscrita no CNPJ/MF sob o n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o CNPJ]</span><span>, estabelecida &agrave;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o&nbsp;endere&ccedil;o completo da empresa]</span><span>, neste ato representada pelo Senhor(a)&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o nome]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[nacionalidade]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[estado civil]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[profiss&atilde;o]</span><span>, portador da Carteira de Identidade n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span><span>&nbsp;e do CPF n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span><span>, cuja proposta foi classificada em primeiro lugar no Grupo </span><span style=\"color:#0000FF;\">XX</span><span> do certame</span>.</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA PRIMEIRA &ndash; DO OBJETO</p>\r\n\r\n<p class=\"Item_Nivel2\"><span>A presente Ata tem por objeto&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>, <span>conforme especifica&ccedil;&otilde;es e condi&ccedil;&otilde;es constantes no Edital e anexos e, ainda, a documenta&ccedil;&atilde;o, as propostas de pre&ccedil;os, os lances apresentados pelo licitante classificado em primeiro lugar e os demais fornecedores que tiveram seus pre&ccedil;os registrados para a forma&ccedil;&atilde;o de cadastro de reserva (incisos I e II do art. 11 do Decreto n&ordm; 7.892/2014), a fim de atender ao quantitativo total estimado para a contrata&ccedil;&atilde;o, observado o pre&ccedil;o da proposta vencedora, visando contrata&ccedil;&otilde;es futuras</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\">Grupo/Itens registrados &ndash; Da especifica&ccedil;&atilde;o e do quantitativo a ser fornecido:</p>\r\n\r\n<table border=\"1\" cellpadding=\"1\" cellspacing=\"0\" style=\"margin-left:auto;margin-right:auto;width:90%;\">\r\n	<thead>\r\n		<tr>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Grupo</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Item</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Descri&ccedil;&atilde;o do Item (Objeto)</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">CATMAT</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Quantidade</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Unidade de Medida</p>\r\n			</th>\r\n		</tr>\r\n	</thead>\r\n	<tbody>\r\n		<tr>\r\n			<td colspan=\"1\" rowspan=\"3\">\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">3</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"1\" rowspan=\"2\">\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Item_Nivel2\"><span style=\"font-size: 12pt; text-align: justify; text-indent: 0mm;\">Este instrumento n&atilde;o obriga a CONTRATANTE a firmar contrata&ccedil;&otilde;es nas quantidades estimadas, podendo ocorrer licita&ccedil;&otilde;es espec&iacute;ficas para aquisi&ccedil;&atilde;o do(s) objetos(s), obedecida a legisla&ccedil;&atilde;o pertinente, sendo assegurada ao fornecedor registrado a prefer&ecirc;ncia, em igualdade de condi&ccedil;&otilde;es.</span></p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA SEGUNDA &ndash; DA RELA&Ccedil;&Atilde;O DOS FORNECEDORES BENEFICI&Aacute;RIOS DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">Em decorr&ecirc;ncia das propostas e lances apresentados e homologados no certame licitat&oacute;rio, ficam registrados, para contrata&ccedil;&otilde;es futuras, os pre&ccedil;os unit&aacute;rios e respectivos fornecedores classificados, conforme Rela&ccedil;&atilde;o dos Fornecedores Benefici&aacute;rios do Registro de Pre&ccedil;os, Anexo I desta Ata.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os fornecedores registrados para forma&ccedil;&atilde;o de cadastro de reserva s&oacute; se beneficiar&atilde;o deste Registro de Pre&ccedil;os no caso de exclus&atilde;o do primeiro colocado da Ata, nas hip&oacute;teses previstas nos artigos 20 e 21 do Decreto n&ordm; 7.892/2013 (&sect; 1&ordm; do art. 11 do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA TERCEIRA &ndash; DA UTILIZA&Ccedil;&Atilde;O DA ATA DE REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">Esta Ata de Registro de Pre&ccedil;os, durante sua vig&ecirc;ncia, poder&aacute; ser utilizada por qualquer &oacute;rg&atilde;o ou entidade da Administra&ccedil;&atilde;o que n&atilde;o tenha participado deste certame, mediante anu&ecirc;ncia da CONTRATANTE, na forma do art. 22 do Decreto n&ordm; 7.892/2013.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &oacute;rg&atilde;os e entidades que n&atilde;o participaram do registro de pre&ccedil;os, quando desejarem fazer uso da ata de registro de pre&ccedil;os, dever&atilde;o consultar a CONTRATANTE para manifesta&ccedil;&atilde;o sobre a possibilidade de ades&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\">Caber&aacute; ao fornecedor benefici&aacute;rio desta ata de registro de pre&ccedil;os, observadas as condi&ccedil;&otilde;es nela estabelecidas, optar pela aceita&ccedil;&atilde;o ou n&atilde;o do fornecimento decorrente de ades&atilde;o, desde que n&atilde;o prejudique as obriga&ccedil;&otilde;es presentes e futuras decorrentes desta ata, assumidas com a CONTRATANTE e demais &oacute;rg&atilde;os participantes.</p>\r\n\r\n<p class=\"Item_Nivel2\">As aquisi&ccedil;&otilde;es ou contrata&ccedil;&otilde;es adicionais decorrentes de ades&atilde;o a esta ata n&atilde;o poder&atilde;o exceder, por &oacute;rg&atilde;o ou entidade, a cem por cento dos quantitativos dos itens do instrumento convocat&oacute;rio e registrados na ata de registro de pre&ccedil;os para a CONTRATANTE e demais &oacute;rg&atilde;os participantes.</p>\r\n\r\n<p class=\"Item_Nivel2\">O quantitativo decorrente das ades&otilde;es a esta ata de registro de pre&ccedil;os n&atilde;o poder&aacute; exceder, na totalidade, ao qu&iacute;ntuplo do quantitativo de cada item registrado na ata de registro de pre&ccedil;os para a CONTRATANTE e demais &oacute;rg&atilde;os participantes, independente do n&uacute;mero de &oacute;rg&atilde;os n&atilde;o participantes que aderirem.</p>\r\n\r\n<p class=\"Item_Nivel2\">Ap&oacute;s a autoriza&ccedil;&atilde;o do &oacute;rg&atilde;o gerenciador, o &oacute;rg&atilde;o n&atilde;o participante dever&aacute; efetivar a aquisi&ccedil;&atilde;o ou contrata&ccedil;&atilde;o solicitada em at&eacute; noventa dias, observado o prazo de vig&ecirc;ncia desta ata.</p>\r\n\r\n<p class=\"Item_Nivel2\">Compete ao &oacute;rg&atilde;o n&atilde;o participante os atos relativos &agrave; cobran&ccedil;a do cumprimento pelo fornecedor das obriga&ccedil;&otilde;es contratualmente assumidas e a aplica&ccedil;&atilde;o, observada a ampla defesa e o contradit&oacute;rio, de eventuais penalidades decorrentes do descumprimento de cl&aacute;usulas contratuais, em rela&ccedil;&atilde;o &agrave;s suas pr&oacute;prias contrata&ccedil;&otilde;es, informando as ocorr&ecirc;ncias &agrave; CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &oacute;rg&atilde;os ou entidades que utilizarem esta Ata de Registro de Pre&ccedil;os dever&atilde;o observar, quanto ao pre&ccedil;o unit&aacute;rio, &agrave;s cl&aacute;usulas e condi&ccedil;&otilde;es constantes do Edital do Preg&atilde;o que a precedeu e que integra o presente instrumento de compromisso.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &Oacute;rg&atilde;os ou Entidades n&atilde;o participantes, ou caronas, somente poder&atilde;o efetuar ades&otilde;es &agrave; Ata de Registro de Pre&ccedil;os mediante pr&eacute;via e expressa autoriza&ccedil;&atilde;o do &oacute;rg&atilde;o gerenciador, conforme determina o art. 22 do Decreto n&ordm; 7.892 de 23/01/2013.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA QUARTA &ndash;&nbsp;DA VIG&Ecirc;NCIA</p>\r\n\r\n<p class=\"Item_Nivel2\">A vig&ecirc;ncia da Ata de Registro de Pre&ccedil;o ser&aacute; de <span style=\"color:#0000FF;\">[digite aqui a quantidade de meses]</span> meses contados da data da sua assinatura, com efic&aacute;cia legal ap&oacute;s a da data da publica&ccedil;&atilde;o do seu extrato no Di&aacute;rio Oficial da Uni&atilde;o, tendo in&iacute;cio e vencimento em dia de expediente, devendo-se excluir o primeiro e incluir o &uacute;ltimo.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA QUINTA &ndash;&nbsp;DA REVIS&Atilde;O DOS PRE&Ccedil;OS REGISTRADOS</p>\r\n\r\n<p class=\"Item_Nivel2\">Durante a vig&ecirc;ncia da Ata, os pre&ccedil;os registrados ser&atilde;o fixos e irreajust&aacute;veis, exceto nas hip&oacute;teses previstas nos arts. 17 e 18 do Decreto n&ordm; 7.892/2013 e devidamente comprovadas &agrave;s situa&ccedil;&otilde;es previstas na al&iacute;nea &ldquo;d&rdquo; do inciso II do art. 65 da Lei n&ordm; 8.666/1993 ou decorrentes de redu&ccedil;&atilde;o dos pre&ccedil;os praticados no mercado.</p>\r\n\r\n<p class=\"Item_Nivel3\">Mesmo comprovada &agrave; ocorr&ecirc;ncia de situa&ccedil;&atilde;o prevista na al&iacute;nea &ldquo;d&rdquo; do inciso II do art. 65 da Lei n&ordm; 8.666/1993, a Administra&ccedil;&atilde;o, se julgar conveniente, poder&aacute; optar por revogar a Ata e iniciar outro processo licitat&oacute;rio.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando o pre&ccedil;o registrado se tornar superior ao pre&ccedil;o praticado no mercado por motivo superveniente, o &oacute;rg&atilde;o gerenciador definir&aacute; o novo pre&ccedil;o m&aacute;ximo a ser pago pela Administra&ccedil;&atilde;o e convocar&aacute; os fornecedores para negociarem a redu&ccedil;&atilde;o dos pre&ccedil;os aos valores praticados pelo mercado.</p>\r\n\r\n<p class=\"Item_Nivel3\">Os fornecedores que n&atilde;o aceitarem reduzir seus pre&ccedil;os aos valores praticados pelo mercado ser&atilde;o liberados do compromisso assumido, sem aplica&ccedil;&atilde;o de penalidade.</p>\r\n\r\n<p class=\"Item_Nivel3\">A ordem de classifica&ccedil;&atilde;o dos fornecedores que aceitarem reduzir seus pre&ccedil;os aos valores de mercado observar&aacute; a classifica&ccedil;&atilde;o original.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando o pre&ccedil;o de mercado se tornar superior aos pre&ccedil;os registrados e o fornecedor n&atilde;o puder cumprir o compromisso, o &oacute;rg&atilde;o gerenciador poder&aacute;:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">liberar o fornecedor do compromisso assumido, caso a comunica&ccedil;&atilde;o ocorra antes do pedido de fornecimento, e sem aplica&ccedil;&atilde;o da penalidade se confirmada a veracidade dos motivos e comprovantes apresentados; e</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">convocar os demais fornecedores para assegurar igual oportunidade de negocia&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando os fornecedores registrados n&atilde;o aceitarem manter o pre&ccedil;o originariamente fixado na ata, o &oacute;rg&atilde;o gerenciador dever&aacute; proceder &agrave; revoga&ccedil;&atilde;o da ata de registro de pre&ccedil;os, adotando as medidas cab&iacute;veis para obten&ccedil;&atilde;o da contrata&ccedil;&atilde;o mais vantajosa.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA SEXTA &ndash;&nbsp;DO REMANEJAMENTO DAS QUANTIDADES PREVISTAS PARA OS ITENS COM PRE&Ccedil;OS REGISTRADOS</p>\r\n\r\n<p class=\"Item_Nivel2\">As quantidades previstas para os itens com pre&ccedil;os registrados poder&atilde;o ser remanejadas pela CONTRATANTE entre os &oacute;rg&atilde;os participantes e n&atilde;o participantes do procedimento licitat&oacute;rio para registro de pre&ccedil;os.</p>\r\n\r\n<p class=\"Item_Nivel3\">O remanejamento somente poder&aacute; ser feito de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o participante e de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o n&atilde;o participante.</p>\r\n\r\n<p class=\"Item_Nivel3\">No caso de remanejamento de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o n&atilde;o participante, ser&atilde;o observados os limites previstos nos &sect;&sect; 3&ordm; e 4&ordm; do art. 22 do Decreto n&ordm; 7.892, de 23 de janeiro de 2013.</p>\r\n\r\n<p class=\"Item_Nivel3\">Caber&aacute; &agrave; CONTRATANTE autorizar o remanejamento solicitado, com a redu&ccedil;&atilde;o do quantitativo inicialmente informado pelo &oacute;rg&atilde;o participante, desde que haja pr&eacute;via anu&ecirc;ncia do &oacute;rg&atilde;o que vier a sofrer redu&ccedil;&atilde;o dos quantitativos informados.</p>\r\n\r\n<p class=\"Item_Nivel3\">Caso o remanejamento seja feito entre &oacute;rg&atilde;os de Estados ou Munic&iacute;pios distintos, caber&aacute; ao fornecedor benefici&aacute;rio da Ata de Registro de Pre&ccedil;os, observadas as condi&ccedil;&otilde;es nela estabelecidas, optar pela aceita&ccedil;&atilde;o ou n&atilde;o do fornecimento decorrente do remanejamento dos itens.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA S&Eacute;TIMA &ndash;&nbsp;DO CANCELAMENTO DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">O Fornecedor Benefici&aacute;rio ter&aacute; seu registro de pre&ccedil;o cancelado na Ata, por interm&eacute;dio de processo administrativo espec&iacute;fico, assegurado o contradit&oacute;rio e ampla defesa:</p>\r\n\r\n<p class=\"Item_Nivel3\">A pedido, quando:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">comprovar est&aacute; impossibilitado de cumprir as exig&ecirc;ncias da Ata, por ocorr&ecirc;ncia de casos fortuitos ou de for&ccedil;a maior devidamente comprovados;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o seu pre&ccedil;o registrado se tornar, comprovadamente, inexequ&iacute;vel em fun&ccedil;&atilde;o da eleva&ccedil;&atilde;o dos pre&ccedil;os de mercado, dos insumos que comp&otilde;em o custo das aquisi&ccedil;&otilde;es/contrata&ccedil;&otilde;es, e se a comunica&ccedil;&atilde;o ocorrer antes do pedido de fornecimento, sem aplica&ccedil;&atilde;o de penalidade.</p>\r\n\r\n<p class=\"Item_Nivel3\">Por iniciativa da CONTRATANTE, quando:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor n&atilde;o aceitar reduzir o pre&ccedil;o registrado, na hip&oacute;tese deste se tornar superior &agrave;queles praticados no mercado, sem aplica&ccedil;&atilde;o de penalidade (&sect; 1&ordm; do art. 18 Decreto n&ordm; 7.892/2013);</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor perder qualquer condi&ccedil;&atilde;o de habilita&ccedil;&atilde;o exigida no processo licitat&oacute;rio, garantida a possibilidade da aplica&ccedil;&atilde;o de penalidade;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">por raz&otilde;es de interesse p&uacute;blico, devidamente motivadas e justificadas;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">n&atilde;o cumprir as obriga&ccedil;&otilde;es decorrentes da Ata de Registro de Pre&ccedil;o;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor n&atilde;o assinar o Contrato ou instrumento equivalente, no prazo estabelecido pela CONTRATANTE, sem justificativa aceit&aacute;vel;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">n&atilde;o comparecer ou se recusar a retirar, no prazo estabelecido, os pedidos decorrentes da Ata de Registro de Pre&ccedil;o;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">caracterizada qualquer hip&oacute;tese de inexecu&ccedil;&atilde;o total ou parcial das condi&ccedil;&otilde;es estabelecidas na Ata de Registro de Pre&ccedil;o ou nos pedidos dela decorrentes;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">sofrer san&ccedil;&atilde;o prevista nos incisos III ou IV do caput do art. 87 da Lei n&ordm; 8.666/1993 ou no art. 7&ordm; da Lei n&ordm; 10.520/2002&nbsp;(art. 20, IV, do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel2\">Ocorrendo qualquer das hip&oacute;teses, conclu&iacute;do o processo, a CONTRATANTE far&aacute; o devido apostilamento na Ata de Registro de Pre&ccedil;o e informar&aacute; ao Fornecedor Benefici&aacute;rio a nova ordem de registro.</p>\r\n\r\n<p class=\"Item_Nivel2\">Esta Ata de Registro de Pre&ccedil;o ser&aacute; cancelada automaticamente:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">por decurso do prazo de vig&ecirc;ncia;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">quando n&atilde;o restarem fornecedores registrados.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA OITAVA &ndash; DAS CONDI&Ccedil;&Otilde;ES PARA O ACEITE DA NOTA DE EMPENHO</p>\r\n\r\n<p class=\"Item_Nivel2\">As empresas detentoras dos pre&ccedil;os registrados poder&atilde;o ser convidadas a firmar contrata&ccedil;&otilde;es de fornecimento, observadas as condi&ccedil;&otilde;es fixadas neste instrumento, e seus Anexos, e na legisla&ccedil;&atilde;o pertinente.</p>\r\n\r\n<p class=\"Item_Nivel2\">Para cada fornecimento, a contrata&ccedil;&atilde;o formalizar-se-&aacute; mediante emiss&atilde;o de nota de empenho em nome da licitante que tenha firmado esta Ata de Registro de Pre&ccedil;os e o titular do &oacute;rg&atilde;o ou entidade CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">A licitante vencedora receber&aacute;, por escrito (e-mail ou fax), c&oacute;pia da Nota de Empenho, para no prazo de 05 (cinco) dias &uacute;teis, contados da notifica&ccedil;&atilde;o, promover o aceite, sob pena de decair o direito &agrave; contrata&ccedil;&atilde;o, sem preju&iacute;zo da aplica&ccedil;&atilde;o das penalidades cab&iacute;veis.</p>\r\n\r\n<p class=\"Item_Nivel3\">O prazo de convoca&ccedil;&atilde;o poder&aacute; ser prorrogado, uma &uacute;nica vez, por igual per&iacute;odo, quando solicitado pelo licitante vencedor, por escrito, durante o seu transcurso e desde que ocorra motivo justificado e aceito pela CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">Em cada fornecimento decorrente desta Ata ser&atilde;o observadas, quanto ao pre&ccedil;o unit&aacute;rio, as cl&aacute;usulas e condi&ccedil;&otilde;es constantes do Edital do Preg&atilde;o que a precedeu e que integra o presente instrumento de compromisso.</p>\r\n\r\n<p class=\"Item_Nivel2\">A emiss&atilde;o da Nota de Empenho decorrente do Sistema de Registro de Pre&ccedil;os dever&aacute; ser assinado no prazo de validade da ata de registro de pre&ccedil;os.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA NONA &ndash;&nbsp;DO PRE&Ccedil;O</p>\r\n\r\n<p class=\"Item_Nivel2\">O pre&ccedil;o consignado no contrato ser&aacute; o registrado nesta Ata, conforme registrado no resultado do Preg&atilde;o Eletr&ocirc;nico.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA &ndash;&nbsp;DAS OBRIGA&Ccedil;&Otilde;ES DO FORNECEDOR BENEFICI&Aacute;RIO</p>\r\n\r\n<p class=\"Item_Nivel2\">Os fornecedores detentores dos pre&ccedil;os registrados dever&atilde;o cumprir o compromisso firmado por interm&eacute;dio do presente instrumento, nos termos dispostos nos Decretos n&ordm; 7.892/2013 e n&ordm; 8.250/2014 e no Edital de Preg&atilde;o e seus anexos, e cumprir, integralmente, todas as cl&aacute;usulas e condi&ccedil;&otilde;es constantes dos contratos ou instrumentos equivalentes porventura firmados, sob pena de revoga&ccedil;&atilde;o da presente Ata de Registro de Pre&ccedil;os, sem preju&iacute;zo das aplica&ccedil;&otilde;es das penalidades cab&iacute;veis.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA PRIMEIRA &ndash; DO RECEBIMENTO E CRIT&Eacute;RIO DE ACEITA&Ccedil;&Atilde;O DO OBJETO</p>\r\n\r\n<p class=\"Item_Nivel2\">Os servi&ccedil;os ser&atilde;o recebidos na forma do Termo de Refer&ecirc;ncia, Anexo I do Edital.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA SEGUNDA &ndash; DO PAGAMENTO</p>\r\n\r\n<p class=\"Item_Nivel2\">O pagamento dar-se-&aacute; na forma do edital e do Termo de Refer&ecirc;ncia, Anexo I do Edital.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA TERCEIRA &ndash; DAS PENALIDADES</p>\r\n\r\n<p class=\"Item_Nivel2\">O descumprimento da Ata de Registro de Pre&ccedil;os ensejar&aacute; aplica&ccedil;&atilde;o das penalidades estabelecidas no 7&ordm; da Lei n&ordm; 10.520/2002 e no art. 28 do Decreto n&ordm; 5.450/2005, bem como no Edital e Contrato.</p>\r\n\r\n<p class=\"Item_Nivel2\">&Eacute; da compet&ecirc;ncia do &oacute;rg&atilde;o gerenciador a aplica&ccedil;&atilde;o das penalidades decorrentes do descumprimento do pactuado nesta ata de registro de pre&ccedil;o (art. 5&ordm;, inciso X, do Decreto n&ordm; 7.892/2013), exceto nas hip&oacute;teses em que o descumprimento disser respeito &agrave;s contrata&ccedil;&otilde;es dos &oacute;rg&atilde;os participantes, caso no qual caber&aacute; ao respectivo &oacute;rg&atilde;o participante &agrave; aplica&ccedil;&atilde;o da penalidade (art. 6&ordm;, par&aacute;grafo &uacute;nico, do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA OITAVA &ndash; DAS DISPOSI&Ccedil;&Otilde;ES FINAIS</p>\r\n\r\n<p class=\"Item_Nivel2\">As partes ficam, ainda, adstritas &agrave;s seguintes disposi&ccedil;&otilde;es:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">todas as altera&ccedil;&otilde;es que se fizerem necess&aacute;rias ser&atilde;o registradas por interm&eacute;dio de lavratura de Termo Aditivo &agrave; presente ata de Registro de Pre&ccedil;os;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">integram esta Ata o Fornecedor Benefici&aacute;rio do Registro de Pre&ccedil;os, sua proposta e, ainda, o Edital de Preg&atilde;o e seus anexos.</p>\r\n\r\n<p class=\"Item_Nivel2\">&Eacute; vedado efetuar acr&eacute;scimos nos quantitativos fixados por esta ata de registro de pre&ccedil;os, inclusive o acr&eacute;scimo de que trata o &sect; 1&ordm; do art. 65 da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os contratos decorrentes desta ata de registro de pre&ccedil;os poder&atilde;o ser alterados, observado o disposto no art. 65 da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA NONA &ndash; DO FORO</p>\r\n\r\n<p class=\"Item_Nivel2\">Fica eleito o foro da Se&ccedil;&atilde;o Judici&aacute;ria da Justi&ccedil;a Federal de <span style=\"color:#0000FF;\">[digite aqui a cidade/Estado da subse&ccedil;&atilde;o judici&aacute;ria]</span> para dirimir quaisquer quest&otilde;es oriundas do presente Contrato, com exclus&atilde;o de qualquer outro.</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\">E, para firmeza e prova de assim haverem, entre si, ajustado e acordado, ap&oacute;s ter sido lido juntamente com seu(s) anexo(s),&nbsp;o presente Contrato &eacute; assinado eletronicamente pelas partes.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(742,113,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(743,113,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(744,114,'Cabeçalho','<div align=\"center\">@timbre_orgao@\r\n<p style=\"margin:0;font-family:Calibri;font-size:9pt;\">@descricao_orgao_maiusculas@<br />\r\n@endereco_unidade@, @complemento_endereco_unidade@ @hifen_bairro_unidade@, @cidade_unidade@/@sigla_uf_unidade@, @cep_unidade@<br />\r\nTelefone: @telefone_unidade@ e Fax: @fax_unidade@ @hifen_sitio_internet_orgao@<br />\r\n&nbsp;&nbsp;</p>\r\n</div>\r\n',0,'S','N','N','S','S','N','S','S'),(745,114,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(746,114,'Processo','<p class=\"Texto_Justificado\">Processo n&ordm; @processo@</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n',20,'S','N','N','S','N','N','S','S'),(747,114,'Corpo do Texto','<p class=\"Texto_Justificado\">PREG&Atilde;O ELETR&Ocirc;NICO PARA REGISTRO DE PRE&Ccedil;OS N&ordm; <span style=\"color:#0000FF;\">XX/XXXX</span></p>\r\n\r\n<p class=\"Texto_Justificado\"><strong>Validade da Ata:</strong> <span style=\"color:#0000FF;\">XX</span>&nbsp;meses</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\">Aos <span style=\"color:#0000FF;\">XX</span> dias do m&ecirc;s de <span style=\"color:#0000FF;\">XXXXXXXX</span> de @ano@, a Uni&atilde;o, por interm&eacute;dio da <strong>@descricao_orgao_maiusculas@ &ndash;&nbsp;@sigla_orgao_origem@</strong>, inscrita no CNPJ/MF sob o n&ordm;&nbsp;<span style=\"color:#0000FF;\">[digite aqui o CNPJ]</span>, com sede na&nbsp;<span style=\"color:#0000FF;\">[digite aqui o endere&ccedil;o completo]</span>, doravante denominada CONTRATANTE,&nbsp;por interm&eacute;dio do seu <span style=\"color:#0000FF;\">[Cargo do Signat&aacute;rio 1]</span>, Senhor(a) <span style=\"color:#0000FF;\">[digite aqui o nome]</span>, <span style=\"color:#0000FF;\">[nacionalidade]</span>, <span style=\"color:#0000FF;\">[estado civil]</span>, portador da Carteira de Identidade n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span> e do CPF n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span>, e do seu <span style=\"color:#0000FF;\">[Cargo do Signat&aacute;rio 2]</span>, Senhor(a) <span style=\"color:#0000FF;\">[digite aqui o nome]</span>, <span style=\"color:#0000FF;\">[nacionalidade]</span>, <span style=\"color:#0000FF;\">[estado civil]</span>, portador da Carteira de Identidade n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span>, CPF n&ordm; <span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span>,</p>\r\n\r\n<p class=\"Texto_Justificado\">CONSIDERANDO o disposto na Lei n&ordm; 10.520/2002, no Decreto n&ordm; 7.892/2013, no Decreto n&ordm; 8.250/2014, no Decreto n&ordm; 5.450/2005, no Decreto n&ordm; 3.722/2001, aplicando-se, subsidiariamente, a Lei n&ordm; 8.666/1993, e as demais normas legais correlatas; e</p>\r\n\r\n<p class=\"Texto_Justificado\">CONSIDERANDO a classifica&ccedil;&atilde;o das propostas apresentadas no Preg&atilde;o Eletr&ocirc;nico para Registro de Pre&ccedil;os em ep&iacute;grafe, conforme Ata publicada em <span style=\"color:#0000FF;\">XX/XX/XXXX</span>, homologada pela autoridade competente,</p>\r\n\r\n<p class=\"Texto_Justificado\"><strong>RESOLVE:</strong></p>\r\n\r\n<p class=\"Texto_Justificado\">REGISTRAR OS PRE&Ccedil;OS para a eventual contrata&ccedil;&atilde;o dos itens a seguir elencados, conforme <span>Cl&aacute;usulas abaixo e&nbsp;</span>especifica&ccedil;&otilde;es do Termo de Refer&ecirc;ncia, que passa a fazer parte integrante desta, tendo sido, os referidos pre&ccedil;os, oferecidos pela<span>&nbsp;</span><span style=\"color:#0000FF;\"><strong>[DIGITE AQUI O NOME DA EMPRESA]</strong></span><span>, inscrita no CNPJ/MF sob o n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o CNPJ]</span><span>, estabelecida &agrave;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o&nbsp;endere&ccedil;o completo da empresa]</span><span>, neste ato representada pelo Senhor(a)&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o nome]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[nacionalidade]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[estado civil]</span><span>,&nbsp;</span><span style=\"color:#0000FF;\">[profiss&atilde;o]</span><span>, portador da Carteira de Identidade n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero com a Unidade da Federa&ccedil;&atilde;o]</span><span>&nbsp;e do CPF n&ordm;&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o n&uacute;mero]</span><span>, cuja proposta foi classificada em primeiro lugar no Grupo </span><span style=\"color:#0000FF;\">XX</span><span> do certame</span>.</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA PRIMEIRA &ndash; DO OBJETO</p>\r\n\r\n<p class=\"Item_Nivel2\"><span>A presente Ata tem por objeto&nbsp;</span><span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>, <span>conforme especifica&ccedil;&otilde;es e condi&ccedil;&otilde;es constantes no Edital e anexos e, ainda, a documenta&ccedil;&atilde;o, as propostas de pre&ccedil;os, os lances apresentados pelo licitante classificado em primeiro lugar e os demais fornecedores que tiveram seus pre&ccedil;os registrados para a forma&ccedil;&atilde;o de cadastro de reserva (incisos I e II do art. 11 do Decreto n&ordm; 7.892/2014), a fim de atender ao quantitativo total estimado para a contrata&ccedil;&atilde;o, observado o pre&ccedil;o da proposta vencedora, visando contrata&ccedil;&otilde;es futuras</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\">Grupo/Itens registrados &ndash; Da especifica&ccedil;&atilde;o e do quantitativo a ser fornecido:</p>\r\n\r\n<table border=\"1\" cellpadding=\"1\" cellspacing=\"0\" style=\"margin-left:auto;margin-right:auto;width:90%;\">\r\n	<thead>\r\n		<tr>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Grupo</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Item</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Descri&ccedil;&atilde;o do Item (Objeto)</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">CATMAT</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Quantidade</p>\r\n			</th>\r\n			<th scope=\"col\" style=\"background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Unidade de Medida</p>\r\n			</th>\r\n		</tr>\r\n	</thead>\r\n	<tbody>\r\n		<tr>\r\n			<td colspan=\"1\" rowspan=\"3\">\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">3</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td colspan=\"1\" rowspan=\"2\">\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">1</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">2</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n			<td>\r\n			<p class=\"Tabela_Texto_Centralizado\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Item_Nivel2\"><span style=\"font-size: 12pt; text-align: justify; text-indent: 0mm;\">Este instrumento n&atilde;o obriga a CONTRATANTE a firmar contrata&ccedil;&otilde;es nas quantidades estimadas, podendo ocorrer licita&ccedil;&otilde;es espec&iacute;ficas para aquisi&ccedil;&atilde;o do(s) objetos(s), obedecida a legisla&ccedil;&atilde;o pertinente, sendo assegurada ao fornecedor registrado a prefer&ecirc;ncia, em igualdade de condi&ccedil;&otilde;es.</span></p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA SEGUNDA &ndash; DA RELA&Ccedil;&Atilde;O DOS FORNECEDORES BENEFICI&Aacute;RIOS DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">Em decorr&ecirc;ncia das propostas e lances apresentados e homologados no certame licitat&oacute;rio, ficam registrados, para contrata&ccedil;&otilde;es futuras, os pre&ccedil;os unit&aacute;rios e respectivos fornecedores classificados, conforme Rela&ccedil;&atilde;o dos Fornecedores Benefici&aacute;rios do Registro de Pre&ccedil;os, Anexo I desta Ata.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os fornecedores registrados para forma&ccedil;&atilde;o de cadastro de reserva s&oacute; se beneficiar&atilde;o deste Registro de Pre&ccedil;os no caso de exclus&atilde;o do primeiro colocado da Ata, nas hip&oacute;teses previstas nos artigos 20 e 21 do Decreto n&ordm; 7.892/2013 (&sect; 1&ordm; do art. 11 do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA TERCEIRA &ndash; DA UTILIZA&Ccedil;&Atilde;O DA ATA DE REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">Esta Ata de Registro de Pre&ccedil;os, durante sua vig&ecirc;ncia, poder&aacute; ser utilizada por qualquer &oacute;rg&atilde;o ou entidade da Administra&ccedil;&atilde;o que n&atilde;o tenha participado deste certame, mediante anu&ecirc;ncia da CONTRATANTE, na forma do art. 22 do Decreto n&ordm; 7.892/2013.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &oacute;rg&atilde;os e entidades que n&atilde;o participaram do registro de pre&ccedil;os, quando desejarem fazer uso da ata de registro de pre&ccedil;os, dever&atilde;o consultar a CONTRATANTE para manifesta&ccedil;&atilde;o sobre a possibilidade de ades&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\">Caber&aacute; ao fornecedor benefici&aacute;rio desta ata de registro de pre&ccedil;os, observadas as condi&ccedil;&otilde;es nela estabelecidas, optar pela aceita&ccedil;&atilde;o ou n&atilde;o do fornecimento decorrente de ades&atilde;o, desde que n&atilde;o prejudique as obriga&ccedil;&otilde;es presentes e futuras decorrentes desta ata, assumidas com a CONTRATANTE e demais &oacute;rg&atilde;os participantes.</p>\r\n\r\n<p class=\"Item_Nivel2\">As aquisi&ccedil;&otilde;es ou contrata&ccedil;&otilde;es adicionais decorrentes de ades&atilde;o a esta ata n&atilde;o poder&atilde;o exceder, por &oacute;rg&atilde;o ou entidade, a cem por cento dos quantitativos dos itens do instrumento convocat&oacute;rio e registrados na ata de registro de pre&ccedil;os para a CONTRATANTE e demais &oacute;rg&atilde;os participantes.</p>\r\n\r\n<p class=\"Item_Nivel2\">O quantitativo decorrente das ades&otilde;es a esta ata de registro de pre&ccedil;os n&atilde;o poder&aacute; exceder, na totalidade, ao qu&iacute;ntuplo do quantitativo de cada item registrado na ata de registro de pre&ccedil;os para a CONTRATANTE e demais &oacute;rg&atilde;os participantes, independente do n&uacute;mero de &oacute;rg&atilde;os n&atilde;o participantes que aderirem.</p>\r\n\r\n<p class=\"Item_Nivel2\">Ap&oacute;s a autoriza&ccedil;&atilde;o do &oacute;rg&atilde;o gerenciador, o &oacute;rg&atilde;o n&atilde;o participante dever&aacute; efetivar a aquisi&ccedil;&atilde;o ou contrata&ccedil;&atilde;o solicitada em at&eacute; noventa dias, observado o prazo de vig&ecirc;ncia desta ata.</p>\r\n\r\n<p class=\"Item_Nivel2\">Compete ao &oacute;rg&atilde;o n&atilde;o participante os atos relativos &agrave; cobran&ccedil;a do cumprimento pelo fornecedor das obriga&ccedil;&otilde;es contratualmente assumidas e a aplica&ccedil;&atilde;o, observada a ampla defesa e o contradit&oacute;rio, de eventuais penalidades decorrentes do descumprimento de cl&aacute;usulas contratuais, em rela&ccedil;&atilde;o &agrave;s suas pr&oacute;prias contrata&ccedil;&otilde;es, informando as ocorr&ecirc;ncias &agrave; CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &oacute;rg&atilde;os ou entidades que utilizarem esta Ata de Registro de Pre&ccedil;os dever&atilde;o observar, quanto ao pre&ccedil;o unit&aacute;rio, &agrave;s cl&aacute;usulas e condi&ccedil;&otilde;es constantes do Edital do Preg&atilde;o que a precedeu e que integra o presente instrumento de compromisso.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os &Oacute;rg&atilde;os ou Entidades n&atilde;o participantes, ou caronas, somente poder&atilde;o efetuar ades&otilde;es &agrave; Ata de Registro de Pre&ccedil;os mediante pr&eacute;via e expressa autoriza&ccedil;&atilde;o do &oacute;rg&atilde;o gerenciador, conforme determina o art. 22 do Decreto n&ordm; 7.892 de 23/01/2013.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA QUARTA &ndash;&nbsp;DA VIG&Ecirc;NCIA</p>\r\n\r\n<p class=\"Item_Nivel2\">A vig&ecirc;ncia da Ata de Registro de Pre&ccedil;o ser&aacute; de <span style=\"color:#0000FF;\">[digite aqui a quantidade de meses]</span> meses contados da data da sua assinatura, com efic&aacute;cia legal ap&oacute;s a da data da publica&ccedil;&atilde;o do seu extrato no Di&aacute;rio Oficial da Uni&atilde;o, tendo in&iacute;cio e vencimento em dia de expediente, devendo-se excluir o primeiro e incluir o &uacute;ltimo.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA QUINTA &ndash;&nbsp;DA REVIS&Atilde;O DOS PRE&Ccedil;OS REGISTRADOS</p>\r\n\r\n<p class=\"Item_Nivel2\">Durante a vig&ecirc;ncia da Ata, os pre&ccedil;os registrados ser&atilde;o fixos e irreajust&aacute;veis, exceto nas hip&oacute;teses previstas nos arts. 17 e 18 do Decreto n&ordm; 7.892/2013 e devidamente comprovadas &agrave;s situa&ccedil;&otilde;es previstas na al&iacute;nea &ldquo;d&rdquo; do inciso II do art. 65 da Lei n&ordm; 8.666/1993 ou decorrentes de redu&ccedil;&atilde;o dos pre&ccedil;os praticados no mercado.</p>\r\n\r\n<p class=\"Item_Nivel3\">Mesmo comprovada &agrave; ocorr&ecirc;ncia de situa&ccedil;&atilde;o prevista na al&iacute;nea &ldquo;d&rdquo; do inciso II do art. 65 da Lei n&ordm; 8.666/1993, a Administra&ccedil;&atilde;o, se julgar conveniente, poder&aacute; optar por revogar a Ata e iniciar outro processo licitat&oacute;rio.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando o pre&ccedil;o registrado se tornar superior ao pre&ccedil;o praticado no mercado por motivo superveniente, o &oacute;rg&atilde;o gerenciador definir&aacute; o novo pre&ccedil;o m&aacute;ximo a ser pago pela Administra&ccedil;&atilde;o e convocar&aacute; os fornecedores para negociarem a redu&ccedil;&atilde;o dos pre&ccedil;os aos valores praticados pelo mercado.</p>\r\n\r\n<p class=\"Item_Nivel3\">Os fornecedores que n&atilde;o aceitarem reduzir seus pre&ccedil;os aos valores praticados pelo mercado ser&atilde;o liberados do compromisso assumido, sem aplica&ccedil;&atilde;o de penalidade.</p>\r\n\r\n<p class=\"Item_Nivel3\">A ordem de classifica&ccedil;&atilde;o dos fornecedores que aceitarem reduzir seus pre&ccedil;os aos valores de mercado observar&aacute; a classifica&ccedil;&atilde;o original.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando o pre&ccedil;o de mercado se tornar superior aos pre&ccedil;os registrados e o fornecedor n&atilde;o puder cumprir o compromisso, o &oacute;rg&atilde;o gerenciador poder&aacute;:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">liberar o fornecedor do compromisso assumido, caso a comunica&ccedil;&atilde;o ocorra antes do pedido de fornecimento, e sem aplica&ccedil;&atilde;o da penalidade se confirmada a veracidade dos motivos e comprovantes apresentados; e</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">convocar os demais fornecedores para assegurar igual oportunidade de negocia&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel3\">Quando os fornecedores registrados n&atilde;o aceitarem manter o pre&ccedil;o originariamente fixado na ata, o &oacute;rg&atilde;o gerenciador dever&aacute; proceder &agrave; revoga&ccedil;&atilde;o da ata de registro de pre&ccedil;os, adotando as medidas cab&iacute;veis para obten&ccedil;&atilde;o da contrata&ccedil;&atilde;o mais vantajosa.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA SEXTA &ndash;&nbsp;DO REMANEJAMENTO DAS QUANTIDADES PREVISTAS PARA OS ITENS COM PRE&Ccedil;OS REGISTRADOS</p>\r\n\r\n<p class=\"Item_Nivel2\">As quantidades previstas para os itens com pre&ccedil;os registrados poder&atilde;o ser remanejadas pela CONTRATANTE entre os &oacute;rg&atilde;os participantes e n&atilde;o participantes do procedimento licitat&oacute;rio para registro de pre&ccedil;os.</p>\r\n\r\n<p class=\"Item_Nivel3\">O remanejamento somente poder&aacute; ser feito de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o participante e de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o n&atilde;o participante.</p>\r\n\r\n<p class=\"Item_Nivel3\">No caso de remanejamento de &oacute;rg&atilde;o participante para &oacute;rg&atilde;o n&atilde;o participante, ser&atilde;o observados os limites previstos nos &sect;&sect; 3&ordm; e 4&ordm; do art. 22 do Decreto n&ordm; 7.892, de 23 de janeiro de 2013.</p>\r\n\r\n<p class=\"Item_Nivel3\">Caber&aacute; &agrave; CONTRATANTE autorizar o remanejamento solicitado, com a redu&ccedil;&atilde;o do quantitativo inicialmente informado pelo &oacute;rg&atilde;o participante, desde que haja pr&eacute;via anu&ecirc;ncia do &oacute;rg&atilde;o que vier a sofrer redu&ccedil;&atilde;o dos quantitativos informados.</p>\r\n\r\n<p class=\"Item_Nivel3\">Caso o remanejamento seja feito entre &oacute;rg&atilde;os de Estados ou Munic&iacute;pios distintos, caber&aacute; ao fornecedor benefici&aacute;rio da Ata de Registro de Pre&ccedil;os, observadas as condi&ccedil;&otilde;es nela estabelecidas, optar pela aceita&ccedil;&atilde;o ou n&atilde;o do fornecimento decorrente do remanejamento dos itens.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA S&Eacute;TIMA &ndash;&nbsp;DO CANCELAMENTO DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Item_Nivel2\">O Fornecedor Benefici&aacute;rio ter&aacute; seu registro de pre&ccedil;o cancelado na Ata, por interm&eacute;dio de processo administrativo espec&iacute;fico, assegurado o contradit&oacute;rio e ampla defesa:</p>\r\n\r\n<p class=\"Item_Nivel3\">A pedido, quando:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">comprovar est&aacute; impossibilitado de cumprir as exig&ecirc;ncias da Ata, por ocorr&ecirc;ncia de casos fortuitos ou de for&ccedil;a maior devidamente comprovados;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o seu pre&ccedil;o registrado se tornar, comprovadamente, inexequ&iacute;vel em fun&ccedil;&atilde;o da eleva&ccedil;&atilde;o dos pre&ccedil;os de mercado, dos insumos que comp&otilde;em o custo das aquisi&ccedil;&otilde;es/contrata&ccedil;&otilde;es, e se a comunica&ccedil;&atilde;o ocorrer antes do pedido de fornecimento, sem aplica&ccedil;&atilde;o de penalidade.</p>\r\n\r\n<p class=\"Item_Nivel3\">Por iniciativa da CONTRATANTE, quando:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor n&atilde;o aceitar reduzir o pre&ccedil;o registrado, na hip&oacute;tese deste se tornar superior &agrave;queles praticados no mercado, sem aplica&ccedil;&atilde;o de penalidade (&sect; 1&ordm; do art. 18 Decreto n&ordm; 7.892/2013);</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor perder qualquer condi&ccedil;&atilde;o de habilita&ccedil;&atilde;o exigida no processo licitat&oacute;rio, garantida a possibilidade da aplica&ccedil;&atilde;o de penalidade;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">por raz&otilde;es de interesse p&uacute;blico, devidamente motivadas e justificadas;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">n&atilde;o cumprir as obriga&ccedil;&otilde;es decorrentes da Ata de Registro de Pre&ccedil;o;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">o fornecedor n&atilde;o assinar o Contrato ou instrumento equivalente, no prazo estabelecido pela CONTRATANTE, sem justificativa aceit&aacute;vel;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">n&atilde;o comparecer ou se recusar a retirar, no prazo estabelecido, os pedidos decorrentes da Ata de Registro de Pre&ccedil;o;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">caracterizada qualquer hip&oacute;tese de inexecu&ccedil;&atilde;o total ou parcial das condi&ccedil;&otilde;es estabelecidas na Ata de Registro de Pre&ccedil;o ou nos pedidos dela decorrentes;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">sofrer san&ccedil;&atilde;o prevista nos incisos III ou IV do caput do art. 87 da Lei n&ordm; 8.666/1993 ou no art. 7&ordm; da Lei n&ordm; 10.520/2002&nbsp;(art. 20, IV, do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel2\">Ocorrendo qualquer das hip&oacute;teses, conclu&iacute;do o processo, a CONTRATANTE far&aacute; o devido apostilamento na Ata de Registro de Pre&ccedil;o e informar&aacute; ao Fornecedor Benefici&aacute;rio a nova ordem de registro.</p>\r\n\r\n<p class=\"Item_Nivel2\">Esta Ata de Registro de Pre&ccedil;o ser&aacute; cancelada automaticamente:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">por decurso do prazo de vig&ecirc;ncia;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">quando n&atilde;o restarem fornecedores registrados.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA OITAVA &ndash; DAS CONDI&Ccedil;&Otilde;ES PARA O ACEITE DA NOTA DE EMPENHO</p>\r\n\r\n<p class=\"Item_Nivel2\">As empresas detentoras dos pre&ccedil;os registrados poder&atilde;o ser convidadas a firmar contrata&ccedil;&otilde;es de fornecimento, observadas as condi&ccedil;&otilde;es fixadas neste instrumento, e seus Anexos, e na legisla&ccedil;&atilde;o pertinente.</p>\r\n\r\n<p class=\"Item_Nivel2\">Para cada fornecimento, a contrata&ccedil;&atilde;o formalizar-se-&aacute; mediante emiss&atilde;o de nota de empenho em nome da licitante que tenha firmado esta Ata de Registro de Pre&ccedil;os e o titular do &oacute;rg&atilde;o ou entidade CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">A licitante vencedora receber&aacute;, por escrito (e-mail ou fax), c&oacute;pia da Nota de Empenho, para no prazo de 05 (cinco) dias &uacute;teis, contados da notifica&ccedil;&atilde;o, promover o aceite, sob pena de decair o direito &agrave; contrata&ccedil;&atilde;o, sem preju&iacute;zo da aplica&ccedil;&atilde;o das penalidades cab&iacute;veis.</p>\r\n\r\n<p class=\"Item_Nivel3\">O prazo de convoca&ccedil;&atilde;o poder&aacute; ser prorrogado, uma &uacute;nica vez, por igual per&iacute;odo, quando solicitado pelo licitante vencedor, por escrito, durante o seu transcurso e desde que ocorra motivo justificado e aceito pela CONTRATANTE.</p>\r\n\r\n<p class=\"Item_Nivel2\">Em cada fornecimento decorrente desta Ata ser&atilde;o observadas, quanto ao pre&ccedil;o unit&aacute;rio, as cl&aacute;usulas e condi&ccedil;&otilde;es constantes do Edital do Preg&atilde;o que a precedeu e que integra o presente instrumento de compromisso.</p>\r\n\r\n<p class=\"Item_Nivel2\">A emiss&atilde;o da Nota de Empenho decorrente do Sistema de Registro de Pre&ccedil;os dever&aacute; ser assinado no prazo de validade da ata de registro de pre&ccedil;os.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA NONA &ndash;&nbsp;DO PRE&Ccedil;O</p>\r\n\r\n<p class=\"Item_Nivel2\">O pre&ccedil;o consignado no contrato ser&aacute; o registrado nesta Ata, conforme registrado no resultado do Preg&atilde;o Eletr&ocirc;nico.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA &ndash;&nbsp;DAS OBRIGA&Ccedil;&Otilde;ES DO FORNECEDOR BENEFICI&Aacute;RIO</p>\r\n\r\n<p class=\"Item_Nivel2\">Os fornecedores detentores dos pre&ccedil;os registrados dever&atilde;o cumprir o compromisso firmado por interm&eacute;dio do presente instrumento, nos termos dispostos nos Decretos n&ordm; 7.892/2013 e n&ordm; 8.250/2014 e no Edital de Preg&atilde;o e seus anexos, e cumprir, integralmente, todas as cl&aacute;usulas e condi&ccedil;&otilde;es constantes dos contratos ou instrumentos equivalentes porventura firmados, sob pena de revoga&ccedil;&atilde;o da presente Ata de Registro de Pre&ccedil;os, sem preju&iacute;zo das aplica&ccedil;&otilde;es das penalidades cab&iacute;veis.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA PRIMEIRA &ndash; DO RECEBIMENTO E CRIT&Eacute;RIO DE ACEITA&Ccedil;&Atilde;O DO OBJETO</p>\r\n\r\n<p class=\"Item_Nivel2\">Os servi&ccedil;os ser&atilde;o recebidos na forma do Termo de Refer&ecirc;ncia, Anexo I do Edital.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA SEGUNDA &ndash; DO PAGAMENTO</p>\r\n\r\n<p class=\"Item_Nivel2\">O pagamento dar-se-&aacute; na forma do edital e do Termo de Refer&ecirc;ncia, Anexo I do Edital.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA TERCEIRA &ndash; DAS PENALIDADES</p>\r\n\r\n<p class=\"Item_Nivel2\">O descumprimento da Ata de Registro de Pre&ccedil;os ensejar&aacute; aplica&ccedil;&atilde;o das penalidades estabelecidas no 7&ordm; da Lei n&ordm; 10.520/2002 e no art. 28 do Decreto n&ordm; 5.450/2005, bem como no Edital e Contrato.</p>\r\n\r\n<p class=\"Item_Nivel2\">&Eacute; da compet&ecirc;ncia do &oacute;rg&atilde;o gerenciador a aplica&ccedil;&atilde;o das penalidades decorrentes do descumprimento do pactuado nesta ata de registro de pre&ccedil;o (art. 5&ordm;, inciso X, do Decreto n&ordm; 7.892/2013), exceto nas hip&oacute;teses em que o descumprimento disser respeito &agrave;s contrata&ccedil;&otilde;es dos &oacute;rg&atilde;os participantes, caso no qual caber&aacute; ao respectivo &oacute;rg&atilde;o participante &agrave; aplica&ccedil;&atilde;o da penalidade (art. 6&ordm;, par&aacute;grafo &uacute;nico, do Decreto n&ordm; 7.892/2013).</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA OITAVA &ndash; DAS DISPOSI&Ccedil;&Otilde;ES FINAIS</p>\r\n\r\n<p class=\"Item_Nivel2\">As partes ficam, ainda, adstritas &agrave;s seguintes disposi&ccedil;&otilde;es:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">todas as altera&ccedil;&otilde;es que se fizerem necess&aacute;rias ser&atilde;o registradas por interm&eacute;dio de lavratura de Termo Aditivo &agrave; presente ata de Registro de Pre&ccedil;os;</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">integram esta Ata o Fornecedor Benefici&aacute;rio do Registro de Pre&ccedil;os, sua proposta e, ainda, o Edital de Preg&atilde;o e seus anexos.</p>\r\n\r\n<p class=\"Item_Nivel2\">&Eacute; vedado efetuar acr&eacute;scimos nos quantitativos fixados por esta ata de registro de pre&ccedil;os, inclusive o acr&eacute;scimo de que trata o &sect; 1&ordm; do art. 65 da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel2\">Os contratos decorrentes desta ata de registro de pre&ccedil;os poder&atilde;o ser alterados, observado o disposto no art. 65 da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel1\">CL&Aacute;USULA D&Eacute;CIMA NONA &ndash; DO FORO</p>\r\n\r\n<p class=\"Item_Nivel2\">Fica eleito o foro da Se&ccedil;&atilde;o Judici&aacute;ria da Justi&ccedil;a Federal de <span style=\"color:#0000FF;\">[digite aqui a cidade/Estado da subse&ccedil;&atilde;o judici&aacute;ria]</span> para dirimir quaisquer quest&otilde;es oriundas do presente Contrato, com exclus&atilde;o de qualquer outro.</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\">E, para firmeza e prova de assim haverem, entre si, ajustado e acordado, ap&oacute;s ter sido lido juntamente com seu(s) anexo(s),&nbsp;o presente Contrato &eacute; assinado eletronicamente pelas partes.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(748,114,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(749,114,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(750,114,'Anexos','<p class=\"Texto_Centralizado_Maiusculas\">ANEXO I</p>\r\n\r\n<p class=\"Texto_Centralizado_Maiusculas\">RELA&Ccedil;&Atilde;O DOS FORNECEDORES BENEFICI&Aacute;RIOS DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Fornecedor 1.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 2.</span></p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 4.</span></p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 4.</span></p>\r\n',50,'N','N','N','N','N','N','S','S'),(751,113,'Anexos','<p class=\"Texto_Centralizado_Maiusculas\">ANEXO I</p>\r\n\r\n<p class=\"Texto_Centralizado_Maiusculas\">RELA&Ccedil;&Atilde;O DOS FORNECEDORES BENEFICI&Aacute;RIOS DO REGISTRO DE PRE&Ccedil;OS</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\">Fornecedor 1.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 2.</span></p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 4.</span></p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\"><span>Fornecedor 4.</span></p>\r\n',50,'N','N','N','N','N','N','S','S'),(752,115,'Cabeçalho','<div align=\"center\">@timbre_orgao@\r\n<p style=\"margin:0;font-family:Calibri;font-size:9pt;\">@descricao_orgao_maiusculas@<br />\r\n@endereco_unidade@, @complemento_endereco_unidade@ @hifen_bairro_unidade@, @cidade_unidade@/@sigla_uf_unidade@, @cep_unidade@<br />\r\nTelefone: @telefone_unidade@ e Fax: @fax_unidade@ @hifen_sitio_internet_orgao@<br />\r\n&nbsp;&nbsp;</p>\r\n</div>\r\n',0,'S','N','N','S','S','N','S','S'),(753,115,'Título do Documento','<p class=\"Texto_Centralizado_Maiusculas\">@serie@</p>\r\n\r\n<p class=\"Texto_Centralizado_Maiusculas\">INEXIGIBILIDADE DE LICITA&Ccedil;&Atilde;O N&ordm; @numeracao_serie@/@ano@</p>\r\n',10,'S','N','N','S','N','N','S','S'),(754,115,'Processo','<p class=\"Texto_Justificado\">Processo n&ordm; @processo@</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n',20,'S','N','N','S','N','N','S','S'),(755,115,'Corpo do Texto','<p class=\"Texto_Justificado\"><strong>Unidade Gestora</strong>: <span style=\"color:#0000FF;\">[digite aqui a&nbsp;sigla da unidade gestora]</span></p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">DO RECONHECIMENTO DA INEXIGIBILIDADE DE LICITA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\">O <span style=\"color:#0000FF;\">[digite o nome da autoridade competente por reconhecer]</span>&nbsp;<strong>RECONHECE</strong>&nbsp;a situa&ccedil;&atilde;o de INEXIGIBILIDADE DE LICITA&Ccedil;&Atilde;O, com fulcro&nbsp;no art. 26,&nbsp;caput, da Lei n&ordm; 8.666/1993, fundamentado no&nbsp;<span style=\"color:#0000FF;\">[digite o respectivo enquadramento - caput ou inciso da inexigibilidade]</span> do art. 25 da Lei n&ordm; 8.666/1993, combinado com <span style=\"color:#0000FF;\">[digite o respectivo inciso da inexigibilidade]</span> da mesma Lei, conforme Projeto B&aacute;sico SEI n&ordm; <span style=\"color:#0000FF;\">xxxxxxx</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Do Objeto</strong>: <span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\">A contrata&ccedil;&atilde;o ser&aacute; registrada e publicada no sistema Comprasnet, na situa&ccedil;&atilde;o de Inexigibilidade de Licita&ccedil;&atilde;o, com amparo na legisla&ccedil;&atilde;o supracitada.</p>\r\n\r\n<p class=\"Item_Nivel2\">Encaminhe-se o presente documento para <strong>RATIFICA&Ccedil;&Atilde;O</strong> pelo&nbsp;<span style=\"color:#0000FF;\">[digite o nome da autoridade competente por ratificar]</span>, nos termos do art. 26&nbsp;da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel1\">DA RATIFICA&Ccedil;&Atilde;O DA INEXIGIBILIDADE DE LICITA&Ccedil;&Atilde;O E DA AUTORIZA&Ccedil;&Atilde;O DA CONTRATA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Justificativa e raz&atilde;o da escolha do fornecedor</strong>:</p>\r\n\r\n<p class=\"Item_Nivel3\"><span style=\"color:#0000FF;\">[digite a justificativa e a raz&atilde;o da escolha do fornecedor da contrata&ccedil;&atilde;o constante no Projeto B&aacute;sico].</span></p>\r\n\r\n<p class=\"Item_Nivel3\"><span style=\"color:#0000FF;\">[digite a justificativa e a raz&atilde;o da escolha do fornecedor da contrata&ccedil;&atilde;o constante no Projeto B&aacute;sico].</span></p>\r\n\r\n<p class=\"Item_Nivel2\">Base Legal: <span style=\"color:#0000FF;\">[digite aqui o fundamento legal que autoriza a inexigibilidade, transcrevendo o dispositivo logo abaixo conforme exemplo]</span></p>\r\n\r\n<p class=\"Citacao\">Art. 25. &Eacute; inexig&iacute;vel a licita&ccedil;&atilde;o quando houver inviabilidade de competi&ccedil;&atilde;o, em especial:</p>\r\n\r\n<p class=\"Citacao\">II - para a contrata&ccedil;&atilde;o de servi&ccedil;os t&eacute;cnicos enumerados no art. 13 desta Lei, de natureza singular, com profissionais ou empresas de not&oacute;ria especializa&ccedil;&atilde;o, vedada a inexigibilidade para servi&ccedil;os de publicidade e divulga&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Citacao\">(...)</p>\r\n\r\n<p class=\"Citacao\">Art. 13. Para os fins desta Lei, consideram-se servi&ccedil;os t&eacute;cnicos profissionais especializados os trabalhos relativos a:</p>\r\n\r\n<p class=\"Citacao\">VI - treinamento e aperfei&ccedil;oamento de pessoal;</p>\r\n\r\n<p class=\"Citacao\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Contratada</strong>:&nbsp;<span style=\"color:#0000FF;\">[digite a raz&atilde;o social da empresa e seu CNPJ]</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Valor Total da Contrata&ccedil;&atilde;o</strong>: R$ <span style=\"color:#0000FF;\">[digite o valor]</span></p>\r\n\r\n<p class=\"Item_Nivel2\">Diante dos dados expostos, o&nbsp;<span style=\"color:#0000FF;\">[digite o nome da autoridade competente por ratificar]</span>&nbsp;<strong>RATIFICA</strong> a situa&ccedil;&atilde;o de INEXIGIBILIDADE DE LICITA&Ccedil;&Atilde;O, com fulcro&nbsp;no art. 26,&nbsp;caput, da Lei n&ordm; 8.666/1993, fundamentado no&nbsp;<span style=\"color:#0000FF;\">[digite o respectivo enquadramento - caput ou inciso da inexigibilidade]</span> do art. 25 da Lei n&ordm; 8.666/1993, combinado com <span style=\"color:#0000FF;\">[digite o respectivo inciso da inexigibilidade]</span> da mesma Lei, conforme Projeto B&aacute;sico SEI n&ordm; <span style=\"color:#0000FF;\">xxxxxxx</span>, e <strong>AUTORIZA</strong>, com fulcro no Decreto n&ordm; 7.689/2012, a contrata&ccedil;&atilde;o <span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>.</p>\r\n\r\n<p class=\"Item_Nivel1\">DA EXEQUIBILIDADE DO ATO</p>\r\n\r\n<p class=\"Item_Nivel2\">Objetivando &agrave; exequibilidade deste Ato composto, com vistas a torn&aacute;-lo apto e dispon&iacute;vel para produzir seus regulares efeitos, o mesmo &eacute; assinado pelas autoridades que procederam ao reconhecimento e &agrave; ratifica&ccedil;&atilde;o acima.</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Observa&ccedil;&atilde;o (apagar)</strong>: O texto abaixo somente ser&aacute; necess&aacute;rio nos casos em&nbsp;que a contrata&ccedil;&atilde;o for <u>acima</u> dos valores previstos no art. 24, incisos I e II, da Lei n&ordm; 8666/1993.</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Da Publica&ccedil;&atilde;o</strong>:</p>\r\n\r\n<p class=\"Item_Nivel3\">Publique-se no Di&aacute;rio Oficial da Uni&atilde;o.</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Observa&ccedil;&atilde;o (apagar)</strong>: O texto abaixo somente ser&aacute; necess&aacute;rio nos casos em que a contrata&ccedil;&atilde;o for <u>at&eacute;</u> o limite dos valores previstos&nbsp;no art. 24, incisos I e II, da Lei n&ordm; 8666/1993.</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Da Publica&ccedil;&atilde;o:</strong></p>\r\n\r\n<p class=\"Item_Nivel3\">Em observ&acirc;ncia ao Princ&iacute;pio da Economicidade, entendo que a presente contrata&ccedil;&atilde;o n&atilde;o necessita ser publicada no Di&aacute;rio Oficial da Uni&atilde;o, conforme estabelece o Ac&oacute;rd&atilde;o TCU n&ordm; 1336/2006-Plen&aacute;rio:</p>\r\n\r\n<p class=\"Citacao\">ACORDAM os Ministros do Tribunal de Contas da Uni&atilde;o, reunidos em Sess&atilde;o Plen&aacute;ria, em:</p>\r\n\r\n<p class=\"Citacao\">9.1. com fundamento no art. 237, inciso VI, conhecer da presente representa&ccedil;&atilde;o, para, no m&eacute;rito, consider&aacute;-la procedente;</p>\r\n\r\n<p class=\"Citacao\">9.2. determinar &agrave; Secretaria de Controle Interno do TCU que reformule o &ldquo;SECOI Comunica n&ordm; 06/2005&rdquo;, dando-lhe a seguinte reda&ccedil;&atilde;o: &ldquo;a efic&aacute;cia dos atos de dispensa e inexigibilidade de licita&ccedil;&atilde;o a que se refere o art. 26 da Lei 8.666/93 (art. 24, incisos III a XXIV, e art. 25 da Lei 8.666/93), <strong>est&aacute; condicionada a sua publica&ccedil;&atilde;o na imprensa oficial, salvo se, em observ&acirc;ncia ao princ&iacute;pio da economicidade, os valores contratados estiverem dentro dos limites fixados nos arts. 24, I e II, da Lei 8.666/93</strong>.&nbsp; (grifo nosso)</p>\r\n',30,'N','N','S','N','N','N','S','S'),(756,115,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(757,115,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(758,116,'Cabeçalho','<div align=\"center\">@timbre_orgao@\r\n<p style=\"margin:0;font-family:Calibri;font-size:9pt;\">@descricao_orgao_maiusculas@<br />\r\n@endereco_unidade@, @complemento_endereco_unidade@ @hifen_bairro_unidade@, @cidade_unidade@/@sigla_uf_unidade@, @cep_unidade@<br />\r\nTelefone: @telefone_unidade@ e Fax: @fax_unidade@ @hifen_sitio_internet_orgao@<br />\r\n&nbsp;&nbsp;</p>\r\n</div>\r\n',0,'S','N','N','S','S','N','S','S'),(759,116,'Título do Documento','<p class=\"Texto_Centralizado_Maiusculas\">@serie@</p>\r\n\r\n<p class=\"Texto_Centralizado_Maiusculas\">DISPENSA DE LICITA&Ccedil;&Atilde;O N&ordm; @numeracao_serie@/@ano@</p>\r\n',10,'S','N','N','S','N','N','S','S'),(760,116,'Processo','<p class=\"Texto_Justificado\">Processo n&ordm; @processo@</p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n',20,'S','N','N','S','N','N','S','S'),(761,116,'Corpo do Texto','<p class=\"Texto_Justificado\"><strong>Unidade Gestora</strong>: <span style=\"color:#0000FF;\">[digite aqui a&nbsp;sigla da unidade gestora]</span></p>\r\n\r\n<p class=\"Texto_Justificado\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">DO RECONHECIMENTO DA dispensa DE LICITA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\">O <span style=\"color:#0000FF;\">[digite o nome da autoridade competente por reconhecer]</span>&nbsp;<strong>RECONHECE</strong>&nbsp;a situa&ccedil;&atilde;o de DISPENSA DE LICITA&Ccedil;&Atilde;O, com fulcro&nbsp;no art. 26,&nbsp;caput, da Lei n&ordm; 8.666/1993, fundamentado no&nbsp;<span style=\"color:#0000FF;\">[digite o respectivo enquadramento - inciso da dispensa]</span> do art. 24&nbsp;da Lei n&ordm; 8.666/1993, conforme Projeto B&aacute;sico SEI n&ordm; <span style=\"color:#0000FF;\">xxxxxxx</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Do Objeto</strong>: <span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>.</p>\r\n\r\n<p class=\"Item_Nivel2\">A contrata&ccedil;&atilde;o ser&aacute; registrada e publicada no sistema Comprasnet, na situa&ccedil;&atilde;o de Dispensa de Licita&ccedil;&atilde;o, com amparo na legisla&ccedil;&atilde;o supracitada.</p>\r\n\r\n<p class=\"Item_Nivel2\">Encaminhe-se o presente documento para <strong>RATIFICA&Ccedil;&Atilde;O</strong> pela&nbsp;<span style=\"color:#0000FF;\">[digite o nome da autoridade competente por ratificar]</span>, nos termos do art. 26&nbsp;da Lei n&ordm; 8.666/1993.</p>\r\n\r\n<p class=\"Item_Nivel1\">DA RATIFICA&Ccedil;&Atilde;O DA DISPENSA DE LICITA&Ccedil;&Atilde;O E DA AUTORIZA&Ccedil;&Atilde;O DA CONTRATA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Justificativa e raz&atilde;o da escolha do fornecedor</strong>:</p>\r\n\r\n<p class=\"Item_Nivel3\"><span style=\"color:#0000FF;\">[digite a justificativa e a raz&atilde;o da escolha do fornecedor da contrata&ccedil;&atilde;o constante no Projeto B&aacute;sico].</span></p>\r\n\r\n<p class=\"Item_Nivel3\"><span style=\"color:#0000FF;\">[digite a justificativa e a raz&atilde;o da escolha do fornecedor da contrata&ccedil;&atilde;o constante no Projeto B&aacute;sico].</span></p>\r\n\r\n<p class=\"Item_Nivel2\">Base Legal: <span style=\"color:#0000FF;\">[digite aqui o fundamento legal que autoriza a dispensa, transcrevendo o dispositivo logo abaixo conforme exemplo]</span></p>\r\n\r\n<p class=\"Citacao\">Art. 24. &Eacute; dispens&aacute;vel a licita&ccedil;&atilde;o:</p>\r\n\r\n<p class=\"Citacao\">II - para outros servi&ccedil;os e compras de valor at&eacute; 10% (dez por cento) do limite previsto na al&iacute;nea &quot;a&quot;, do inciso II do artigo anterior e para aliena&ccedil;&otilde;es, nos casos previstos nesta Lei, desde que n&atilde;o se refiram a parcelas de um mesmo servi&ccedil;o, compra ou aliena&ccedil;&atilde;o de maior vulto que possa ser realizada de uma s&oacute; vez; (Reda&ccedil;&atilde;o dada pela Lei n&ordm; 9.648, de 1998)</p>\r\n\r\n<p class=\"Citacao\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Contratada</strong>:&nbsp;<span style=\"color:#0000FF;\">[digite a raz&atilde;o social da empresa e seu CNPJ]</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Valor Total da Contrata&ccedil;&atilde;o</strong>: R$ <span style=\"color:#0000FF;\">[digite o valor]</span></p>\r\n\r\n<p class=\"Item_Nivel2\">Diante dos dados expostos, o <span style=\"color:#0000FF;\">[digite o nome da autoridade competente por ratificar]</span>&nbsp;<strong>RATIFICA</strong> a situa&ccedil;&atilde;o de DISPENSA DE LICITA&Ccedil;&Atilde;O, com fulcro&nbsp;no art. 26,&nbsp;caput, da Lei n&ordm; 8.666/1993, fundamentado no&nbsp;<span style=\"color:#0000FF;\">[digite o respectivo enquadramento - inciso da dispensa]</span> do art. 24&nbsp;da Lei n&ordm; 8.666/1993, conforme Projeto B&aacute;sico SEI n&ordm; <span style=\"color:#0000FF;\">xxxxxxx</span>, e <strong>AUTORIZA</strong>, com fulcro no Decreto n&ordm; 7.689/2012, a contrata&ccedil;&atilde;o <span style=\"color:#0000FF;\">[digite aqui o objeto da contrata&ccedil;&atilde;o]</span>.</p>\r\n\r\n<p class=\"Item_Nivel1\">DA EXEQUIBILIDADE DO ATO</p>\r\n\r\n<p class=\"Item_Nivel2\">Objetivando &agrave; exequibilidade deste Ato composto, com vistas a torn&aacute;-lo apto e dispon&iacute;vel para produzir seus regulares efeitos, o mesmo &eacute; assinado pelas autoridades que procederam ao reconhecimento e &agrave; ratifica&ccedil;&atilde;o acima.</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Observa&ccedil;&atilde;o (apagar)</strong>: O texto abaixo somente ser&aacute; necess&aacute;rio nos casos em&nbsp;que a contrata&ccedil;&atilde;o for <u>acima</u> dos valores previstos no art. 24, incisos I e II, da Lei n&ordm; 8666/1993.</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Da Publica&ccedil;&atilde;o</strong>:</p>\r\n\r\n<p class=\"Item_Nivel3\">Publique-se no Di&aacute;rio Oficial da Uni&atilde;o.</p>\r\n\r\n<p class=\"Citacao\"><span style=\"color:#0000FF;\"><strong>Observa&ccedil;&atilde;o (apagar)</strong>: O texto abaixo somente ser&aacute; necess&aacute;rio nos casos em que a contrata&ccedil;&atilde;o for <u>at&eacute;</u> o limite dos valores previstos&nbsp;no art. 24, incisos I e II, da Lei n&ordm; 8666/1993.</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><strong>Da Publica&ccedil;&atilde;o:</strong></p>\r\n\r\n<p class=\"Item_Nivel3\">Em observ&acirc;ncia ao Princ&iacute;pio da Economicidade, entendo que a presente contrata&ccedil;&atilde;o n&atilde;o necessita ser publicada no Di&aacute;rio Oficial da Uni&atilde;o, conforme estabelece o Ac&oacute;rd&atilde;o TCU n&ordm; 1336/2006-Plen&aacute;rio:</p>\r\n\r\n<p class=\"Citacao\">ACORDAM os Ministros do Tribunal de Contas da Uni&atilde;o, reunidos em Sess&atilde;o Plen&aacute;ria, em:</p>\r\n\r\n<p class=\"Citacao\">9.1. com fundamento no art. 237, inciso VI, conhecer da presente representa&ccedil;&atilde;o, para, no m&eacute;rito, consider&aacute;-la procedente;</p>\r\n\r\n<p class=\"Citacao\">9.2. determinar &agrave; Secretaria de Controle Interno do TCU que reformule o &ldquo;SECOI Comunica n&ordm; 06/2005&rdquo;, dando-lhe a seguinte reda&ccedil;&atilde;o: &ldquo;a efic&aacute;cia dos atos de dispensa e inexigibilidade de licita&ccedil;&atilde;o a que se refere o art. 26 da Lei 8.666/93 (art. 24, incisos III a XXIV, e art. 25 da Lei 8.666/93), <strong>est&aacute; condicionada a sua publica&ccedil;&atilde;o na imprensa oficial, salvo se, em observ&acirc;ncia ao princ&iacute;pio da economicidade, os valores contratados estiverem dentro dos limites fixados nos arts. 24, I e II, da Lei 8.666/93</strong>.&nbsp; (grifo nosso)</p>\r\n',30,'N','N','S','N','N','N','S','S'),(762,116,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(763,116,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(764,117,'Cabeçalho','<p class=\"Texto_Centralizado_Maiusculas_Negrito\">&nbsp;&nbsp;</p>\r\n<p class=\"Texto_Centralizado_Maiusculas_Negrito\">@descricao_orgao_maiusculas@</p>\r\n<p class=\"Texto_Centralizado_Maiusculas_Negrito\">&nbsp;&nbsp;</p>',0,'S','N','N','S','S','N','S','S'),(765,117,'Título do Documento','@serie@ nº @numeracao_serie@/@ano@',10,'S','N','N','S','N','N','N','S'),(766,117,'Corpo do Texto','<p class=\"Texto_Justificado_Recuo_Primeira_Linha\"><b>O [DIGITE AQUI O NOME DO CARGO] DA @descricao_orgao_maiusculas@</b>, no uso das atribui&ccedil;&otilde;es que lhe foram conferidas pelo art. [DIGITE AQUI O DISPOSITIVO] do&nbsp;[DIGITE AQUI A LEGISLA&Ccedil;&Atilde;O APLICADA], aprovado(a) pela [INDIQUE AQUI A NORMA, SEU N&Uacute;MERO E DATA], e</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO o <a href=\"http://www.planalto.gov.br/ccivil_03/_ato2004-2006/2005/decreto/d5450.htm\" target=\"_blank\">Decreto n&ordm; 5.450, de 31 de maio de 2005</a>, que regulamenta o preg&atilde;o, na forma eletr&ocirc;nica, para aquisi&ccedil;&atilde;o de bens e servi&ccedil;os comuns, e d&aacute; outras provid&ecirc;ncias;</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO a <a href=\"http://www.planalto.gov.br/ccivil_03/Leis/L8666compilado.htm\" target=\"_blank\">Lei n&ordm; 8.666, de 21 de junho de 1993</a>, que regulamenta o art. 37, inciso XXI, da Constitui&ccedil;&atilde;o Federal, institui normas para licita&ccedil;&otilde;es e contratos da Administra&ccedil;&atilde;o P&uacute;blica,&nbsp; e d&aacute; outras provid&ecirc;ncias;</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">CONSIDERANDO o constante dos autos do processo n&ordm; @processo@,</p>\r\n\r\n<p class=\"Texto_Espaco_Duplo_Recuo_Primeira_Linha\">DECIDE:</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\" style=\"margin-left: 120px;\">Determinar a abertura do procedimento licitat&oacute;rio, autorizando a sua realiza&ccedil;&atilde;o, na modalidade Preg&atilde;o, na forma eletr&ocirc;nica, tipo menor pre&ccedil;o, com fulcro no art. 8&ordm;, inciso III, do Decreto n&ordm; 5.450/2005 c/c art. 38, da Lei n&ordm; 8.666/1993, visando &agrave; contrata&ccedil;&atilde;o de <span style=\"color:#0000FF;\">[digite aqui a descri&ccedil;&atilde;o do objeto da contrata&ccedil;&atilde;o]</span>, caracterizado como servi&ccedil;o comum, nos moldes do art. 4&ordm; do Decreto n&ordm; 5.450/2005.</p>\r\n\r\n<p class=\"Paragrafo_Numerado_Nivel1\" style=\"margin-left: 120px;\">Este documento&nbsp;entra em vigor na data de sua publica&ccedil;&atilde;o.</p>\r\n',20,'N','N','S','N','N','N','S','S'),(767,117,'Assinatura',NULL,30,'N','S','N','N','N','N','N','S'),(769,117,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(770,118,'Cabeçalho','<div align=\"center\">@timbre_orgao@<br />\r\n@descricao_orgao_maiusculas@</div>\r\n',0,'S','N','N','S','S','N','S','S'),(771,118,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(772,118,'Processo','Processo nº @processo@',20,'S','N','N','S','N','N','N','S'),(773,118,'Corpo do Texto','<p class=\"Item_Nivel1\" contenteditable=\"false\">DADOS DA VIAGEM</p>\r\n\r\n<table border=\"1\" cellpadding=\"1\" cellspacing=\"0\" style=\"margin-left: 3pt; margin-right: auto; width: 540px;\">\r\n	<tbody>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 264px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">N&uacute;mero da PCDP:</p>\r\n			</th>\r\n			<td style=\"width: 266px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 264px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Data da Partida (indicar a data efetiva):</p>\r\n			</th>\r\n			<td style=\"width: 266px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 264px; background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">Data da Chegada (indicar a data efetiva):</p>\r\n			</th>\r\n			<td style=\"width: 266px;\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">ATIVIDADES REALIZADAS</p>\r\n\r\n<p class=\"Citacao\" contenteditable=\"false\"><span style=\"color:#0000FF;\"><strong>Observa&ccedil;&otilde;es</strong>: Descrever de forma clara e objetiva os assuntos tratados e resultados alcan&ccedil;ados para o &Oacute;rg&atilde;o.</span></p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto de descri&ccedil;&atilde;o das atividades realizadas].</p>\r\n\r\n<p class=\"Item_Nivel2\">[Digite aqui o texto de descri&ccedil;&atilde;o das atividades realizadas].</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">ORIENTA&Ccedil;&Otilde;ES E ENCAMINHAMENTO</p>\r\n\r\n<p class=\"Item_Nivel2\" contenteditable=\"false\">A presta&ccedil;&atilde;o de contas de&nbsp;viagem deve ser efetivada no&nbsp;prazo m&aacute;ximo de 5 (cinco) dias ap&oacute;s o retorno do viajante ao &oacute;rg&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\" contenteditable=\"false\">Ao presente processo devem ser inclu&iacute;dos os canhotos do&nbsp;cart&atilde;o de embarque ou&nbsp;recibo do passageiro obtido quando realizado&nbsp;check-in via Internet&nbsp;ou declara&ccedil;&atilde;o fornecida pela empresa de transporte (art. 4&ordm; da Portaria n&ordm; 505/2009-MP).&nbsp;Os referidos documentos ser&atilde;o&nbsp;anexados, juntamente com este Relat&oacute;rio de Viagem a Servi&ccedil;o, &agrave;&nbsp;PCDP correspondente&nbsp;no Sistema de Concess&atilde;o de Di&aacute;rias e Passagens (SCDP).</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">O presente documento segue assinado pelo viajante (proposto da viagem), que encaminhar&aacute; o processo ao solicitante da viagem para fins de registro no SCDP.</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;&nbsp;</p>\r\n',30,'N','N','S','N','N','N','S','S'),(774,118,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(775,118,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S');
/*!40000 ALTER TABLE `secao_modelo` ENABLE KEYS */;
UNLOCK TABLES;


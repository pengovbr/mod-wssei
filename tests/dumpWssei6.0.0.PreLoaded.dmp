\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 38px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><strong>2</strong></p>\r\n			</td>\r\n			<td style=\"width: 263px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 38px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><strong>3</strong></p>\r\n			</td>\r\n			<td style=\"width: 263px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td style=\"width: 38px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p align=\"center\" class=\"Tabela_Texto_Centralizado\"><strong>...</strong></p>\r\n			</td>\r\n			<td style=\"width: 263px; height: 19px; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">MOTIVA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto de explicita&ccedil;&atilde;o da motiva&ccedil;&atilde;o e demonstrativo de resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\"><span>Digite aqui o</span><span>&nbsp;te</span><span>xto d</span><span>e explicita&ccedil;&atilde;o da motiva&ccedil;&atilde;o e demonstrativo de resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</span></p>\r\n\r\n<p class=\"Item_Nivel2\"><span>Digite aqui o</span><span>&nbsp;te</span><span>xto d</span><span>e explicita&ccedil;&atilde;o da motiva&ccedil;&atilde;o e demonstrativo de resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</span></p>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\">METAS DO PLANEJAMENTO ESTRAT&Eacute;GICO A SEREM ALCAN&Ccedil;ADAS</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto dos resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto dos resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto dos resultados a serem alcan&ccedil;ados com a contrata&ccedil;&atilde;o.</p>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">Em conformidade com o art. 11, <strong>caput</strong>, da <a href=\"https://www.governoeletronico.gov.br/documentos-e-arquivos/1%20-%20IN%204%20%2011-9-14.pdf\" target=\"_blank\">Instru&ccedil;&atilde;o Normativa n&ordm; 4, de 11 de setembro de 2014</a>, emitida pela Secretaria de Log&iacute;stica e Tecnologia da Informa&ccedil;&atilde;o do Minist&eacute;rio do Planejamento, Or&ccedil;amento e Gest&atilde;o, encaminha-se o presente&nbsp;@serie@&nbsp;&agrave; &Aacute;rea de Tecnologia da Informa&ccedil;&atilde;o da @sigla_orgao_origem@&nbsp;para as provid&ecirc;ncias cab&iacute;veis.</p>\r\n\r\n<p class=\"Texto_Justificado\">O presente documento segue assinado pelo Respons&aacute;vel pela Demanda&nbsp;identificado na se&ccedil;&atilde;o 1 acima.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(500,73,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(501,73,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(502,74,'Cabeçalho','<div align=\"center\">@timbre_orgao@<br />\r\n@descricao_orgao_maiusculas@</div>\r\n',0,'S','N','N','S','S','N','S','S'),(503,74,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(504,74,'Processo','Processo nº @processo@',20,'S','N','N','S','N','N','N','S'),(505,74,'Corpo do Texto','<p class=\"Item_Nivel1\">IDENTIFICA&Ccedil;&Atilde;O DA &Aacute;REA DE TECNOLOGIA DA INFORMA&Ccedil;&Atilde;O</p>\r\n\r\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left: auto; margin-right: auto; table-layout: fixed; width: 98%;\">\r\n	<tbody>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border: 1pt solid rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\"><b>Integrante T&eacute;cnico:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border: 1pt solid rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border: 1pt solid rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\"><b>E-mail:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border: 1pt solid rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border: 1pt solid rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\"><b>Telefone:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border: 1pt solid rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\" style=\"word-wrap: break-word\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">AVALIA&Ccedil;&Atilde;O DO ALINHAMENTO DA CONTRATA&Ccedil;&Atilde;O AO PDTI</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\">Em conformidade com o art. 11, &sect; 1&ordm;, da <a href=\"https://www.governoeletronico.gov.br/documentos-e-arquivos/1%20-%20IN%204%20%2011-9-14.pdf\" target=\"_blank\">Instru&ccedil;&atilde;o Normativa n&ordm; 4, de 11 de setembro de 2014</a>, emitida pela Secretaria de Log&iacute;stica e Tecnologia da Informa&ccedil;&atilde;o do Minist&eacute;rio do Planejamento, Or&ccedil;amento e Gest&atilde;o, a &aacute;rea de Tecnologia da Informa&ccedil;&atilde;o da @sigla_orgao_origem@ opina pela regularidade do alinhamento da contrata&ccedil;&atilde;o objeto do Documento de Oficializa&ccedil;&atilde;o da Demanda (SEI n&ordm; xxxxxxx) ao PDTI aprovado por meio da Portaria n&ordm; ___, de ___ de __________ de _____.</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Texto_Justificado\" contenteditable=\"false\">Com isso, indica-se o Integrante T&eacute;cnico acima identificado para compor a Equipe de Planejamento da Contrata&ccedil;&atilde;o a ser institu&iacute;da pela autoridade competente da &Aacute;rea Administrativa, em cumprimento ao disposto no &sect; 2&ordm; do art. 11 da <a href=\"https://www.governoeletronico.gov.br/documentos-e-arquivos/1%20-%20IN%204%20%2011-9-14.pdf\" target=\"_blank\">Instru&ccedil;&atilde;o Normativa n&ordm; 4, de 11 de setembro de 2014</a>.</p>\r\n\r\n<p class=\"Texto_Justificado\">Encaminha-se o presente processo &agrave; &Aacute;rea Administrativa competente para as provid&ecirc;ncias cab&iacute;veis.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(506,74,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(507,74,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(508,75,'Cabeçalho','<div align=\"center\">@timbre_orgao@<br />\r\n@descricao_orgao_maiusculas@</div>\r\n',0,'S','N','N','S','S','N','S','S'),(509,75,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(510,75,'Processo','Processo nº @processo@',20,'S','N','N','S','N','N','N','S'),(511,75,'Corpo do Texto','<p class=\"Item_Nivel1\">&#8203;DECIS&Atilde;O SOBRE O PROSSEGUIMENTO DA CONTRATA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\" contenteditable=\"false\">Em cumprimento ao disposto no inciso I do &sect; 2&ordm; do art. 11 da <a href=\"https://www.governoeletronico.gov.br/documentos-e-arquivos/1%20-%20IN%204%20%2011-9-14.pdf\" target=\"_blank\">Instru&ccedil;&atilde;o Normativa n&ordm; 4, de 11 de setembro de 2014</a>, emitida pela Secretaria de Log&iacute;stica e Tecnologia da Informa&ccedil;&atilde;o do Minist&eacute;rio do Planejamento, Or&ccedil;amento e Gest&atilde;o, e:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\">considerando a avalia&ccedil;&atilde;o realizada pela &Aacute;rea de Tecnologia da Informa&ccedil;&atilde;o&nbsp;no documento de&nbsp;Indica&ccedil;&atilde;o de Integrante T&eacute;cnico (SEI n&ordm;&nbsp;xxxxxxx), relativa ao&nbsp;Documento de Oficializa&ccedil;&atilde;o da Demanda (SEI n&ordm;&nbsp;xxxxxxx);</p>\r\n\r\n<p class=\"Item_Inciso_Romano\"><strong>APROVO</strong>&nbsp;o prosseguimento da presente contrata&ccedil;&atilde;o,&nbsp;em raz&atilde;o de sua relev&acirc;ncia e oportunidade em rela&ccedil;&atilde;o aos objetivos estrat&eacute;gicos deste &Oacute;rg&atilde;o&nbsp;e as necessidades da &Aacute;rea Requisitante.</p>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">IDENTIFICA&Ccedil;&Atilde;O DA &Aacute;REA ADMINISTRATIVA&#8203;</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left: auto; margin-right: auto; width: 98%;\">\r\n	<tbody>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\"><b>Integrante Administrativo:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\"><b>E-mail:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<th contenteditable=\"false\" scope=\"row\" style=\"width: 20%; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\"><b>Telefone:</b></p>\r\n			</th>\r\n			<td style=\"width: 80%; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">INSTITUI&Ccedil;&Atilde;O DA EQUIPE DE PLANEJAMENTO DA CONTRATA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Texto_Justificado_Recuo_Primeira_Linha\" contenteditable=\"false\">Em conformidade com&nbsp;o inciso III do &sect; 2&ordm; do art. 11 da supramencionada Instru&ccedil;&atilde;o Normativa, institui-se a Equipe de Planejamento da Contrata&ccedil;&atilde;o, composta pelos seguintes membros:</p>\r\n\r\n<p class=\"Item_Inciso_Romano\"><strong>Integrante Requisitante</strong>: [Digite aqui o nome completo do servidor], conforme documento SEI n&ordm; xxxxxxx.</p>\r\n\r\n<p class=\"Item_Inciso_Romano\"><strong>Integrante T&eacute;cnico</strong>: [Digite aqui o nome completo do servidor], conforme documento SEI n&ordm; xxxxxxx.</p>\r\n\r\n<p class=\"Item_Inciso_Romano\"><strong>Integrante Administrativo</strong>: [Digite aqui o nome completo do servidor], conforme identificado acima.</p>\r\n',30,'N','N','S','N','N','N','S','S'),(512,75,'Assinatura',NULL,40,'N','S','N','N','N','N','N','S'),(513,75,'Rodapé','<hr style=\"border:none; padding:0; margin:5px 2px 0 2px; border-top:medium double #333\" />\r\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\r\n<tr>\r\n<td align=\"left\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\"><strong>Referência:</strong> Processo nº @processo@</td>\r\n<td align=\"right\" style=\"font-family:Calibri;font-size:9pt;border:0;\" width=\"50%\">SEI nº @documento@</td>\r\n</tr>\r\n</table>',1000,'S','N','N','S','N','S','S','S'),(514,76,'Cabeçalho','<div align=\"center\">@timbre_orgao@<br />\r\n@descricao_orgao_maiusculas@</div>\r\n',0,'S','N','N','S','S','N','S','S'),(515,76,'Título do Documento','@serie@',10,'S','N','N','S','N','N','N','S'),(516,76,'Processo','Processo nº @processo@',20,'S','N','N','S','N','N','N','S'),(517,76,'Corpo do Texto','<p class=\"Item_Nivel1\" contenteditable=\"false\">DESCRI&Ccedil;&Atilde;O DA SOLU&Ccedil;&Atilde;O DE TECNOLOGIA DA INFORMA&Ccedil;&Atilde;O</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto... .... .</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto... .... .</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto... .... .</p>\r\n\r\n<p class=\"Item_Nivel2\">Digite aqui o texto... .... .</p>\r\n\r\n<p class=\"Texto_Alinhado_Esquerda_Espacamento_Simples\" contenteditable=\"false\">&nbsp;</p>\r\n\r\n<p class=\"Item_Nivel1\" contenteditable=\"false\">DEFINI&Ccedil;&Atilde;O E ESPECIFICA&Ccedil;&Atilde;O DE&nbsp;REQUISITOS</p>\r\n\r\n<p class=\"Item_Nivel2\" contenteditable=\"false\">Necessidades de Neg&oacute;cio</p>\r\n\r\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-left: auto; margin-right: auto; width: 98%;\">\r\n	<thead>\r\n		<tr>\r\n			<th contenteditable=\"false\" style=\"width: 100px; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\">Necessidade 1:</p>\r\n			</th>\r\n			<th colspan=\"3\" rowspan=\"1\" style=\"border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Alinhado_Esquerda\">&nbsp;</p>\r\n			</th>\r\n		</tr>\r\n	</thead>\r\n	<tbody>\r\n		<tr>\r\n			<td style=\"width: 10%; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\" contenteditable=\"false\"><b>Id</b></p>\r\n			</td>\r\n			<td style=\"border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\" contenteditable=\"false\"><b>Funcionalidade</b></p>\r\n			</td>\r\n			<td style=\"width: 100px; border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\" contenteditable=\"false\"><b>Id</b></p>\r\n			</td>\r\n			<td style=\"border-color: rgb(0, 0, 0); background-color: rgb(204, 204, 204);\">\r\n			<p class=\"Tabela_Texto_Centralizado\" contenteditable=\"false\"><b>Envolvidos</b></p>\r\n			</td>\r\n		</tr>\r\n		<tr>\r\n			<td rowspan=\"2\" style=\"width: 10%; border-color: rgb(0, 0, 0);\">\r\n			<p class=\"Tabela_Texto_Centralizado\"><b>1</b></p>\r\n			</td>\r\n			<td rowspan=\"2\" style=\"border-color: rgb(0, 0